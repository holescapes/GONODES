		"glsl_multi1": {
			"parameters": {
				"cook_once": {
					"value": false
				},
				"shader_code": {
					"value": "shader_type canvas_item;\n\n// --- Threshold Matte (Input Required) ---\n// 3 outputs from a single threshold: masked foreground, alpha matte, inverted matte.\n// Tests uniform parameter binding in GLSLMulti.\n\nuniform sampler2D gn_tex0 : hint_default_white;\nuniform float threshold = 0.5;\nuniform float softness = 0.1;\n\nvoid fragment() {\n\tvec4 src = texture(gn_tex0, UV);\n\tfloat luma = dot(src.rgb, vec3(0.299, 0.587, 0.114));\n\n\tfloat matte = smoothstep(threshold - softness, threshold + softness, luma);\n\n\tgn_out0 = vec4(src.rgb * matte, matte);          // Output 0: masked foreground\n\tgn_out1 = vec4(vec3(matte), 1.0);                // Output 1: matte\n\tgn_out2 = vec4(vec3(1.0 - matte), 1.0);          // Output 2: inverted matte\n}\n"
				},
				"softness": {
					"value": 0.1
				},
				"threshold": {
					"value": 0.5
				},
				"time_dependent": {
					"value": true
				}
			},
			"position": [
				-860.0,
				1760.0
			],
			"type": "GLSLMultiTOP"
		},
