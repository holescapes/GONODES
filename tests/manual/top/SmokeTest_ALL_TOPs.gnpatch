		"glsl_multi1": {
			"parameters": {
				"cook_once": {
					"value": false
				},
				"shader_code": {
					"value": "shader_type canvas_item;\r\n\r\n// --- GONODES Multi-Output Shader ---\r\n// Input textures: gn_tex<N> auto-creates input ports (up to 8).\r\nuniform sampler2D gn_tex0 : hint_default_white;\r\n\r\n// Your uniforms become inspector parameters automatically.\r\n// uniform float brightness = 1.0;\r\n\r\nvoid fragment() {\r\nvec4 src = texture(gn_tex0, UV);\r\nfloat luma = dot(src.rgb, vec3(0.299, 0.587, 0.114));\r\n\r\ngn_out0 = src;                             // Output 0: original\r\ngn_out1 = vec4(vec3(luma), src.a);        // Output 1: luminance\r\n}"
				},
				"time_dependent": {
					"value": true
				}
			},
			"position": [
				2177.0,
				800.0
			],
			"type": "GLSLMultiTOP"
		},
