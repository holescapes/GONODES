	GNTestAssert.assert_not_null(node, "TrailTOP instantiates")
	GNTestAssert.assert_eq(node.node_type, "trail", "node_type")
	GNTestAssert.assert_eq(node.family, 0, "family is TOP")

func test_trail_cook_null() -> void:
	var node := _make_node(TrailTOP.new(), "trail1")
	_cook_no_input(node)
	# No crash = pass. Output may be null for operators that need input.
	GNTestAssert.assert_true(true, "TrailTOP cook-null no crash")
