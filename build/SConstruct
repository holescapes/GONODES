"""
Root SConstruct — Unified build entry point for ALL GONODES GDExtension addons.

Auto-discovers extensions with a native/build.cfg and builds them for the
requested platform/arch.  gn_ext_native is built separately (it uses
godot-cpp's own SConstruct).

Usage:
  # Build shipped extensions on a fresh clone (core + extension tiers; optional skipped):
  scons

  # Build all discovered extensions (optional tier included when SDK present):
  scons tier=all

  # Build core tier only (+ gn_ext_native):
  scons tier=core

  # Build optional tier only (NDI, OpenCV, depth backends, …):
  scons tier=optional

  # Build specific extensions:
  scons ext=gn_ext_hap platform=windows
  scons exts=gn_ext_hap,gn_ext_midi,gn_ext_opencv platform=windows

  # Build gn_ext_native (delegates to its own SConstruct):
  scons ext=gn_ext_native platform=windows

  # List discovered extensions with tier / SDK status:
  scons --list-extensions
"""

import os
import sys

# SConstruct lives in build/, so workspace root is one level up
_build_dir = Dir("#").abspath
_workspace_root = os.path.normpath(os.path.join(_build_dir, ".."))

# Make gn_build.py importable (it's in the same dir as this SConstruct)
sys.path.insert(0, _build_dir)
from gn_build import discover_extensions, make_env, collect_sources, \
    detect_host_platform, detect_host_arch, plan_extensions, copy_runtime_dlls, \
    copy_built_library
from gn_ext_plan import format_extension_table_row, parse_build_cfg

_addons_dir = os.path.join(_workspace_root, "addons")

# ── Arguments ──────────────────────────────────────────────────────────────────

plat = ARGUMENTS.get("platform", "") or detect_host_platform()
target = ARGUMENTS.get("target", "template_release")
arch = ARGUMENTS.get("arch", "") or detect_host_arch()
ext_filter = ARGUMENTS.get("ext", "")
exts_filter = ARGUMENTS.get("exts", "")
tier_filter = ARGUMENTS.get("tier", "")
list_mode = "list-extensions" in ARGUMENTS or "--list-extensions" in sys.argv

# Bare `scons` → shipped (core + extension). Optional tier skipped when SDK missing.
defaults_only = tier_filter in ("minimal",)

if not tier_filter and not ext_filter and not exts_filter:
    tier_filter = "shipped"

if tier_filter == "default":
    tier_filter = "shipped"

print(f"GONODES unified build: platform={plat}  target={target}  arch={arch}")
if tier_filter == "shipped":
    print("  mode: shipped (core + extension tiers; optional skipped)")
elif tier_filter:
    print(f"  tier filter: {tier_filter}")
elif defaults_only:
    print("  mode: minimal (default=true extensions only)")
if ext_filter:
    print(f"  ext filter: {ext_filter}")
if exts_filter:
    print(f"  exts filter: {exts_filter}")

# ── gn_ext_native (special case — uses godot-cpp SConstruct) ──────────────────

native_dir = os.path.join(_addons_dir, "gn_ext_native", "native")

_build_native = False
if ext_filter:
    _build_native = ext_filter == "gn_ext_native"
elif exts_filter:
    _build_native = "gn_ext_native" in {e.strip() for e in exts_filter.split(",") if e.strip()}
elif tier_filter in ("optional", "extension"):
    _build_native = False
elif tier_filter == "minimal":
    _build_native = False
else:
    # shipped, core, all, or explicit tier=core
    _build_native = True

if _build_native:
    native_sconstruct = os.path.join(native_dir, "SConstruct")
    if os.path.isfile(native_sconstruct):
        for _k in ("tier", "ext", "exts"):
            ARGUMENTS.pop(_k, None)
        SConscript(native_sconstruct)

# ── Auto-discover extensions with build.cfg ────────────────────────────────────

extensions = discover_extensions(_addons_dir)

if list_mode:
    print("\n=== Discovered GONODES GDExtension addons ===\n")
    hdr = (
        f"  {'Extension':<30} {'Tier':<10} {'Default':<8} {'Opt':<8} "
        f"{'SDK':<8} {'Library':<20} Platforms"
    )
    print(hdr)
    print(f"  {'-'*30} {'-'*10} {'-'*8} {'-'*8} {'-'*8} {'-'*20} {'-'*20}")
    for ext_name, ext_native_dir, cfg_path in extensions:
        cfg = parse_build_cfg(cfg_path)
        print(format_extension_table_row(ext_name, cfg, plat, ext_native_dir))
    print(f"\n  gn_ext_native (godot-cpp SConstruct — tier=core, always built unless filtered)")
    print(f"\n  Total: {len(extensions) + 1} native extensions")
    print("\n  Build modes:")
    print("    scons                  — shipped (core + extension tiers)")
    print("    scons tier=all         — all tiers including optional")
    print("    scons tier=core        — core tier + gn_ext_native")
    print("    scons tier=optional    — optional tier only")
    print("    scons tier=minimal     — default=true extensions only")
    print("    scons exts=a,b,c       — explicit list\n")
    Exit(0)

to_build, skipped_plan = plan_extensions(
    extensions, plat,
    tier=tier_filter,
    ext=ext_filter,
    exts=exts_filter,
    defaults_only=defaults_only,
)

# ── Build each planned extension ───────────────────────────────────────────────

built = []
skipped = list(skipped_plan)

for ext_name, ext_native_dir, cfg_path, cfg in to_build:
    print(f"\n{'='*60}")
    print(f"Building {ext_name} ({cfg['lib_name']})")
    print(f"{'='*60}")

    godotcpp_root = None
    _search = ext_native_dir
    for _ in range(6):
        _search = os.path.dirname(_search)
        _candidate = os.path.join(_search, "gn_ext_native", "native", "godot-cpp")
        if os.path.isdir(_candidate):
            godotcpp_root = os.path.abspath(_candidate)
            break
    if godotcpp_root is None:
        skipped.append((ext_name, "could not locate godot-cpp"))
        continue

    result = make_env(plat, target, arch, godotcpp_root, cfg, ext_native_dir)
    if result is None:
        skipped.append((ext_name, "make_env returned None"))
        continue

    env, suffix, out_dir, lib_ext = result

    sources = collect_sources(env, cfg, ext_native_dir, plat)
    if not sources:
        skipped.append((ext_name, "no sources found"))
        continue

    os.makedirs(out_dir, exist_ok=True)
    lib_target = os.path.join(out_dir, f"lib{cfg['lib_name']}{suffix}{lib_ext}")
    library = env.SharedLibrary(target=lib_target, source=sources)
    Default(library)
    if cfg.get("library_dest"):
        env.AddPostAction(
            library,
            lambda target, source, env, _cfg=cfg, _plat=plat, _native=ext_native_dir: copy_built_library(
                _cfg, _plat, _native, str(target[0])
            ),
        )
    copy_runtime_dlls(cfg, plat, ext_native_dir, out_dir)
    built.append(ext_name)

# ── Summary ────────────────────────────────────────────────────────────────────

print(f"\n{'='*60}")
print(f"Build summary: {len(built)} extension(s) queued for {plat}/{arch}")
for name in built:
    print(f"  [OK] {name}")
for name, reason in skipped:
    print(f"  [--] {name} -- {reason}")
print(f"{'='*60}\n")

# ── Post-build: sync .gdextension activation ──────────────────────────────────

def _post_build_sync(target, source, env):
    """After all libraries are built, activate .gdextension files whose
    binaries now exist (and deactivate any whose binaries were removed)."""
    sync_script = os.path.join(_workspace_root, "scripts", "sync_gdextensions.py")
    if os.path.isfile(sync_script):
        import subprocess
        subprocess.run(
            [sys.executable, sync_script, "--platform", plat, "--arch", arch],
            cwd=_workspace_root,
        )

if built:
    _sync = Command("_gdext_sync", [], _post_build_sync)
    AlwaysBuild(_sync)
    Depends(_sync, DEFAULT_TARGETS)
