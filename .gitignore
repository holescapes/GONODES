# ═══════════════════════════════════════════════════════════════════════════════
# GONODES .gitignore
#
# Principle: The repo contains SOURCE only.  Everything that can be rebuilt,
# re-downloaded, or regenerated is excluded.  GitHub Actions CI runs setup
# scripts and scons to produce binaries from scratch.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Godot engine artifacts ────────────────────────────────────────────────────
.godot/
/android/
*.import

# ── Built Player/Editor templates (rebuild with scripts/build_templates.ps1) ──
/templates/

# ── GDExtension backup files (created during build, restored automatically) ──
*.gdextension.bak
*.gdextension.uid.bak

# ── godot-cpp (cloned by build system, not a submodule) ──────────────────────
# Every extension that uses godot-cpp clones it into native/godot-cpp/
addons/gn_ext_*/native/godot-cpp/

# ── Windows DLL lock/temp files created by Godot while running ───────────────
~lib*

# ── Platform .gdignore shims ─────────────────────────────────────────────────
# Syphon is macOS-only; on Windows a .gdignore prevents Godot from loading it.
addons/gn_ext_syphon/native/.gdignore

# ── C/C++ build artifacts ────────────────────────────────────────────────────
# SCons places .obj files alongside sources. None of these are needed in the repo.
*.obj
*.o
*.lib
*.exp
*.dblite
*.pdb
*.ilk
*.manifest

# ── Built native binaries (rebuilt by scons / CI) ────────────────────────────
addons/gn_ext_*/native/bin/

# ── Downloaded SDKs & vendor libraries (re-downloaded by setup scripts / CI) ──
# ONNX Runtime — downloaded by setup_ml.py
addons/gn_ext_ml/native/onnxruntime/
addons/gn_ext_ml/models/

# NDI SDK — proprietary, manual download required
addons/gn_ext_ndi/native/ndi_sdk/

# Spout2 SDK — cloned at build time
addons/gn_ext_spout/native/Spout2/

# Embedded CPython — downloaded by setup_python.py
addons/gn_ext_user_python/toolchain/python/
addons/gn_ext_user_python/toolchain/python_env.json

# ── Python ────────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/

# ── Visual Studio project files (generated by SCons/CMake) ───────────────────
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln

# ── Build/test logs & scratch output (local dev only) ────────────────────────
build_output*.txt
build_native.log
test_results.txt
failures.txt
parse_fails.py

# ── OS files ──────────────────────────────────────────────────────────────────
Thumbs.db
.DS_Store
desktop.ini
