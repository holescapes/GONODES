# Godot 4+ specific ignores
.godot/
/android/

# Built Player/Editor templates (large binaries — rebuild with scripts/build_templates.ps1)
/templates/

# GDExtension backup files (created during build, restored automatically)
*.gdextension.bak
*.gdextension.uid.bak

# godot-cpp build dependency (cloned separately, not a submodule)
addons/gn_ext_native/native/godot-cpp/

# Windows DLL lock/temp files created by Godot while running
~lib*

# Platform-local .gdignore files for cross-platform GDExtensions.
# Syphon is macOS-only — on Windows, addons/gn_ext_syphon/native/.gdignore
# prevents Godot from trying to load the macOS-only .gdextension file.
# On macOS dev machines, don't create that file so Syphon loads normally.
addons/gn_ext_syphon/native/.gdignore

# C++ build artifacts (SCons intermediate output — rebuild with scons)
# NOTE: *.obj and *.lib in bin/ dirs ARE tracked (pre-built for users).
# Only ignore SCons cache files and linker temp files.
*.dblite
*.exp
*.pdb

# Python
.venv/
__pycache__/
*.pyc

# Visual Studio project files (generated by SCons/CMake, not hand-written)
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln
