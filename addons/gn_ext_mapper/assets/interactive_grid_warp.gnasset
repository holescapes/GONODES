{
	"identity": {
		"op_name": "InteractiveGridWarp",
		"family": "TOP",
		"description": "Grid warp with interactive NxM drag panel — connect both outputs to WindowOUT for live grid deformation."
	},
	"inner_network": {
		"nodes": {
			"in1": {
				"type": "InTunnel",
				"position": [0, 100],
				"parameters": {
					"index": {"value": 0},
					"family": {"value": 0},
					"label": {"value": "texture"}
				}
			},
			"drag1": {
				"type": "GridDragUI",
				"position": [200, 300],
				"parameters": {
					"label": {"value": "Grid Points"},
					"size": {"value": 250},
					"grid_cols": {"value": 4},
					"grid_rows": {"value": 4}
				}
			},
			"map1": {
				"type": "GridWarpTOP",
				"position": [500, 100],
				"parameters": {
					"grid_cols": {"value": 4},
					"grid_rows": {"value": 4},
					"pt_0_0_x": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_0_0_x\")"},
					"pt_0_0_y": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_0_0_y\")"},
					"pt_1_0_x": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_1_0_x\")"},
					"pt_1_0_y": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_1_0_y\")"},
					"pt_2_0_x": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_2_0_x\")"},
					"pt_2_0_y": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_2_0_y\")"},
					"pt_3_0_x": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_3_0_x\")"},
					"pt_3_0_y": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_3_0_y\")"},
					"pt_0_1_x": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_0_1_x\")"},
					"pt_0_1_y": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_0_1_y\")"},
					"pt_1_1_x": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_1_1_x\")"},
					"pt_1_1_y": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_1_1_y\")"},
					"pt_2_1_x": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_2_1_x\")"},
					"pt_2_1_y": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_2_1_y\")"},
					"pt_3_1_x": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_3_1_x\")"},
					"pt_3_1_y": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_3_1_y\")"},
					"pt_0_2_x": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_0_2_x\")"},
					"pt_0_2_y": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_0_2_y\")"},
					"pt_1_2_x": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_1_2_x\")"},
					"pt_1_2_y": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_1_2_y\")"},
					"pt_2_2_x": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_2_2_x\")"},
					"pt_2_2_y": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_2_2_y\")"},
					"pt_3_2_x": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_3_2_x\")"},
					"pt_3_2_y": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_3_2_y\")"},
					"pt_0_3_x": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_0_3_x\")"},
					"pt_0_3_y": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_0_3_y\")"},
					"pt_1_3_x": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_1_3_x\")"},
					"pt_1_3_y": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_1_3_y\")"},
					"pt_2_3_x": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_2_3_x\")"},
					"pt_2_3_y": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_2_3_y\")"},
					"pt_3_3_x": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_3_3_x\")"},
					"pt_3_3_y": {"mode": "EXPRESSION", "expression": "chop(\"drag1\", \"drag1:pt_3_3_y\")"}
				}
			},
			"out_tex": {
				"type": "OutTunnel",
				"position": [850, 100],
				"parameters": {
					"index": {"value": 0},
					"family": {"value": 0},
					"label": {"value": "warped"}
				}
			},
			"out_panel": {
				"type": "OutTunnel",
				"position": [850, 300],
				"parameters": {
					"index": {"value": 1},
					"family": {"value": 9},
					"label": {"value": "panel"}
				}
			}
		},
		"connections": [
			{"from": "in1", "from_port": 0, "to": "map1", "to_port": 0},
			{"from": "map1", "from_port": 0, "to": "out_tex", "to_port": 0},
			{"from": "drag1", "from_port": 0, "to": "out_panel", "to_port": 0}
		]
	},
	"promoted_parameters": [],
	"custom_parameters": [
		{
			"name": "show_panel",
			"value_type": 2,
			"label": "Show Panel",
			"default_value": true,
			"min_value": 0,
			"max_value": 1,
			"step": 1
		},
		{
			"name": "pad_size",
			"value_type": 1,
			"label": "Pad Size",
			"default_value": 250,
			"min_value": 64,
			"max_value": 512,
			"step": 1
		},
		{
			"name": "grid_cols",
			"value_type": 1,
			"label": "Grid Columns",
			"default_value": 4,
			"min_value": 2,
			"max_value": 8,
			"step": 1
		},
		{
			"name": "grid_rows",
			"value_type": 1,
			"label": "Grid Rows",
			"default_value": 4,
			"min_value": 2,
			"max_value": 8,
			"step": 1
		}
	]
}
