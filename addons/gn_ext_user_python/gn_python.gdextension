[configuration]

entry_symbol = "gn_python_library_init"
compatibility_minimum = 4.1
reloadable = false

[libraries]
windows.x86_64.debug = "res://addons/gn_ext_user_python/bin/win64/libgn_python.windows.template_release.x86_64.dll"
windows.x86_64.release = "res://addons/gn_ext_user_python/bin/win64/libgn_python.windows.template_release.x86_64.dll"
linux.x86_64.debug = "res://addons/gn_ext_user_python/native/bin/linux64/libgn_python.linux.template_release.x86_64.so"
linux.x86_64.release = "res://addons/gn_ext_user_python/native/bin/linux64/libgn_python.linux.template_release.x86_64.so"
macos.debug = "res://addons/gn_ext_user_python/native/bin/macos/libgn_python.macos.template_release.dylib"
macos.release = "res://addons/gn_ext_user_python/native/bin/macos/libgn_python.macos.template_release.dylib"

[dependencies]
windows.x86_64 = {"res://addons/gn_ext_user_python/bin/win64/python310.dll": "", "res://addons/gn_ext_user_python/bin/win64/python3.dll": ""}
linux.x86_64 = {"res://addons/gn_ext_user_python/native/bin/linux64/libpython3.10.so.1.0": ""}
macos = {"res://addons/gn_ext_user_python/native/bin/macos/libpython3.10.dylib": ""}
