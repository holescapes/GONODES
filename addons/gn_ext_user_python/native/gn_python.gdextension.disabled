[configuration]
entry_symbol = "gn_python_library_init"
compatibility_minimum = "4.1"
reloadable = false

[libraries]
windows.debug.x86_64 = "bin/win64/libgn_python.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "bin/win64/libgn_python.windows.template_release.x86_64.dll"
windows.debug.arm64 = "bin/win64/libgn_python.windows.template_debug.arm64.dll"
windows.release.arm64 = "bin/win64/libgn_python.windows.template_release.arm64.dll"
linux.debug.x86_64 = "bin/linux64/libgn_python.linux.template_debug.x86_64.so"
linux.release.x86_64 = "bin/linux64/libgn_python.linux.template_release.x86_64.so"
linux.debug.arm64 = "bin/linux64/libgn_python.linux.template_debug.arm64.so"
linux.release.arm64 = "bin/linux64/libgn_python.linux.template_release.arm64.so"
macos.debug = "bin/macos/libgn_python.macos.template_debug.dylib"
macos.release = "bin/macos/libgn_python.macos.template_release.dylib"
