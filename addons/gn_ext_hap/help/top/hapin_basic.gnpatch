    "info1": {
      "type": "info",
      "position": [200, 400],
      "params": {
        "text": "HapInTOP plays .mov files encoded with the HAP codec.\nDXT-compressed frames upload directly to the GPU —\nno CPU pixel decode needed.\n\nSet the 'file' parameter to a HAP .mov file path.\nSupports HAP (DXT1), HAP Alpha (DXT5), and HAP Q (YCoCg)."
      }
    }
  },
  "connections": [
    {"from": "hapin1", "from_port": 0, "to": "null1", "to_port": 0}
  ]
