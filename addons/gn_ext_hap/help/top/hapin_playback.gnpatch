{
    "version": "1.0",
    "description": "HapInTOP \u2014 Looping with speed control. Demonstrates playback speed and looping.",
    "nodes": {
        "hapin1": {
            "type": "HapInTOP",
            "position": [
                200,
                200
            ],
            "parameters": {
                "file": {
                    "value": ""
                },
                "play": {
                    "value": true,
                    "expression": "sin(time * 2.0) * 0.5 + 0.5",
                    "mode": "EXPRESSION"
                },
                "loop": {
                    "value": true,
                    "expression": "sin(time * 2.0) * 0.5 + 0.5",
                    "mode": "EXPRESSION"
                },
                "speed": {
                    "value": 2.0
                },
                "seek": {
                    "value": -1.0
                }
            }
        },
        "level1": {
            "type": "LevelTOP",
            "position": [
                600,
                200
            ],
            "parameters": {
                "brightness": {
                    "value": 1.0
                },
                "contrast": {
                    "value": 1.2
                }
            }
        },
        "null1": {
            "type": "NullTOP",
            "position": [
                1000,
                200
            ],
            "parameters": {}
        },
        "info1": {
            "type": "InfoDAT",
            "position": [
                200,
                400
            ],
            "parameters": {
                "text": {
                    "value": "HAP playback with speed control.\nSpeed > 1.0 skips frames for fast-forward.\nLoop automatically restarts at the end.\nSeek (sec) overrides the playback position when >= 0."
                }
            }
        },
        "window1": {
            "type": "WindowOUT",
            "position": [
                1300,
                200
            ],
            "parameters": {
                "resolution": {
                    "value": {
                        "_type": "Vector2i",
                        "x": 512,
                        "y": 512
                    }
                },
                "open": {
                    "value": true
                }
            }
        }
    },
    "connections": [
        {
            "from": "hapin1",
            "from_port": 0,
            "to": "level1",
            "to_port": 0
        },
        {
            "from": "level1",
            "from_port": 0,
            "to": "null1",
            "to_port": 0
        },
        {
            "from": "null1",
            "from_port": 0,
            "to": "window1",
            "to_port": 0
        }
    ]
}