{
    "version": "1.0",
    "description": "HapOutTOP — Record a texture to HAP .mov video. Toggle 'record' on to capture, off to finalize.",
    "nodes": {
        "noise1": {
            "type": "NoiseTOP",
            "position": [
                200,
                200
            ],
            "parameters": {
                "resolution": {
                    "value": {
                        "_type": "Vector2i",
                        "x": 512,
                        "y": 512
                    }
                }
            }
        },
        "hapout1": {
            "type": "HapOUT",
            "position": [
                600,
                200
            ],
            "parameters": {
                "file_path": {
                    "value": "user://output/test_hap.mov"
                },
                "variant": {
                    "value": 0
                },
                "fps": {
                    "value": 30
                },
                "record": {
                    "value": false
                }
            }
        },
        "info1": {
            "type": "InfoDAT",
            "position": [
                200,
                400
            ],
            "parameters": {
                "text": {
                    "value": "HapOutTOP records input textures to a HAP .mov file.\n\n1. Set file_path and variant (HAP / HAP Alpha / HAP Q)\n2. Toggle 'record' ON — frames are captured each cook\n3. Toggle 'record' OFF — .mov file is finalized\n\nThe output .mov can be played by HapInTOP with\nzero CPU decode overhead."
                }
            }
        }
    },
    "connections": [
        {
            "from": "noise1",
            "from_port": 0,
            "to": "hapout1",
            "to_port": 0
        }
    ],
    "annotations": [
        {
            "id": "ann_1",
            "type": "note",
            "text": "Hap OUT — Basic\n\nEncode input texture to HAP video file for GPU-direct playback.",
            "position": [
                -100.0,
                -100.0
            ],
            "size": [
                500.0,
                120.0
            ],
            "color": [
                1.0,
