		"shadertoy": {
			"parameters": {
				"fetch": {
					"is_pulse": true,
					"value": false
				},
				"resolution": {
					"value": {
						"_type": "Vector2i",
						"x": 640,
						"y": 360
					}
				},
				"shadertoy_api_key": {
					"value": ""
				},
				"shadertoy_code": {
					"value": "void mainImage(out vec4 fragColor, in vec2 fragCoord) {\n    vec2 uv = fragCoord / iResolution.xy;\n    float t = iTime * 0.3;\n    vec3 col = vec3(0.0);\n    for (int i = 0; i < 4; i++) {\n        float fi = float(i);\n        vec2 p = uv * (2.0 + fi * 0.5) + vec2(t * (0.3 + fi * 0.1), t * 0.2);\n        float n = sin(p.x * 3.0 + sin(p.y * 4.0 + t)) * cos(p.y * 2.5 + cos(p.x * 3.5 - t));\n        n = n * 0.5 + 0.5;\n        col += vec3(n * 0.3, n * 0.25, n * 0.4) / (1.0 + fi * 0.3);\n    }\n    col = pow(col, vec3(0.8));\n    fragColor = vec4(col, 1.0);\n}\n"
				},
				"shadertoy_url": {
					"value": ""
				},
				"time_dependent": {
					"value": true
				}
			},
			"position": [
				340.0,
				-300.0
			],
			"type": "ShadertoyTOP"
		},
		"shadertoy1": {
			"parameters": {
				"block_size": {
					"value": 14.49
				},
				"fetch": {
					"is_pulse": true,
					"value": false
				},
				"shadertoy_api_key": {
					"value": ""
				},
				"shadertoy_code": {
					"value": "// Pixelate — mosaic / blocky pixelation\n// Original GONODES shader — requires iChannel0 input image\n// Uniform: float block_size = 8.0  (pixels per block)\n\nuniform float block_size; // = 8.0\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\n    float bs = max(block_size, 1.0);\n    vec2 pixelated = floor(fragCoord.xy / bs) * bs + bs * 0.5;\n    vec2 uv = pixelated / iResolution.xy;\n    fragColor = texture(iChannel0, uv);\n}\n"
				},
				"shadertoy_url": {
					"value": ""
				},
				"time_dependent": {
					"value": true
				}
			},
