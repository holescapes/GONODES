	"nodes": {
		"shadertoy1": {
			"parameters": {
				"fetch": {
					"is_pulse": true,
					"value": false
				},
				"resolution": {
					"value": {
						"_type": "Vector2i",
						"x": 512,
						"y": 512
					}
				},
				"shadertoy_api_key": {
					"value": ""
				},
				"shadertoy_code": {
					"value": "// Compact Colour Field — demoscene-inspired 1KB visual\n// Inspired by \"Creation\" by Danilo Guanabara (Silexars) — CC BY-NC-SA 3.0\n// https://www.shadertoy.com/view/XsXXDn\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\n    vec3 c;\n    float l, z = iTime;\n    for (int i = 0; i < 3; i++) {\n        vec2 uv, p = fragCoord.xy / iResolution.xy;\n        uv = p;\n        p -= 0.5;\n        p.x *= iResolution.x / iResolution.y;\n        z += 0.07;\n        l = length(p);\n        uv += p / l * (sin(z) + 1.0) * abs(sin(l * 9.0 - z * 2.0));\n        c[i] = 0.01 / length(mod(uv, 1.0) - 0.5);\n    }\n    fragColor = vec4(c / l, 1.0);\n}\n"
				},
				"shadertoy_url": {
					"value": "https://www.shadertoy.com/view/Ms2SD1"
				},
