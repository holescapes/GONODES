                    }
                },
                "noise_type": {
                    "value": 0,
                    "expression": "cos(time * 0.6) * 1.5",
                    "mode": "EXPRESSION"
                },
                "scale": {
                    "value": 4.0,
                    "expression": "0.7 + 0.3 * sin(time * 1.5)",
                    "mode": "EXPRESSION"
                },
                "monochrome": {
                    "value": false
                }
            }
        },
        "shadertoy1": {
            "type": "ShadertoyTOP",
            "position": [
                200,
                100
            ],
            "parameters": {
                "time_dependent": {
                    "value": false
                },
                "resolution": {
                    "value": {
                        "_type": "Vector2i",
                        "x": 512,
                        "y": 512
                    }
                },
                "shadertoy_code": {
                    "value": "void mainImage(out vec4 fragColor, in vec2 fragCoord) {\n\tvec2 uv = fragCoord / iResolution.xy;\n\tvec4 src = texture(iChannel0, uv);\n\t// Chromatic aberration\n\tfloat offset = 0.005;\n\tfloat r = texture(iChannel0, uv + vec2(offset, 0.0)).r;\n\tfloat g = src.g;\n\tfloat b = texture(iChannel0, uv - vec2(offset, 0.0)).b;\n\tvec3 col = vec3(r, g, b);\n\t// Scanlines\n\tcol *= 0.95 + 0.05 * sin(uv.y * iResolution.y * 3.14159);\n\t// Vignette (clamped to avoid negative pow)\n\tvec2 q = uv - 0.5;\n\tfloat vig = clamp(1.0 - dot(q, q) * 2.5, 0.0, 1.0);\n\tcol *= 0.6 + 0.4 * vig;\n\tfragColor = vec4(col, 1.0);\n}"
                }
            }
        },
        "window1": {
            "type": "WindowOUT",
            "position": [
                620,
                100
            ],
            "parameters": {
                "resolution": {
                    "value": {
                        "_type": "Vector2i",
                        "x": 512,
                        "y": 512
                    }
                },
                "open": {
                    "value": true
                }
            }
        }
    },
