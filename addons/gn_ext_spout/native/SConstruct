#!/usr/bin/env python
"""
SConstruct for gn_ext_spout — Spout2 texture sharing GDExtension for GONODES.

Windows-only. Links against pre-built godot-cpp from gn_ext_native WITHOUT
re-invoking godot-cpp's SConstruct (avoids file locks when Godot editor is open).

Usage:
  cd addons/gn_ext_spout/native
  scons platform=windows target=template_release -j4
"""

import os
import sys

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
platform = ARGUMENTS.get("platform", "windows")
target = ARGUMENTS.get("target", "template_release")
arch = ARGUMENTS.get("arch", "x86_64")

if platform != "windows":
    print("gn_ext_spout: Skipping build — Spout is Windows-only.")
    Exit(0)

godotcpp_root = os.path.abspath("../../gn_ext_native/native/godot-cpp")

# ---------------------------------------------------------------------------
# Build environment (matches godot-cpp MSVC settings)
# ---------------------------------------------------------------------------
env = Environment(tools=["default", "msvc"])

# MSVC flags matching godot-cpp's release build
# MSVC flags — must match godot-cpp's CRT choice (/MT for static)
env.Append(CCFLAGS=["/std:c++17", "/EHsc", "/utf-8"])
if target == "template_release":
    env.Append(CCFLAGS=["/O2", "/MT", "/DNDEBUG"])
    suffix = ".windows.template_release.x86_64"
else:
    env.Append(CCFLAGS=["/Od", "/MTd", "/Zi", "/D_DEBUG"])
    suffix = ".windows.template_debug.x86_64"

env.Append(CPPDEFINES=[
    "WINDOWS_ENABLED",
    "TYPED_METHOD_BIND",
    "NOMINMAX",
    "WIN32",
    "_WIN32",
])

# ---------------------------------------------------------------------------
# godot-cpp include paths + pre-built static library
# ---------------------------------------------------------------------------
env.Append(CPPPATH=[
    os.path.join(godotcpp_root, "include"),
    os.path.join(godotcpp_root, "gen", "include"),
    os.path.join(godotcpp_root, "gdextension"),
])

godotcpp_lib = os.path.join(godotcpp_root, "bin",
    "libgodot-cpp" + suffix + ".lib")
env.Append(LIBS=[File(godotcpp_lib)])

# ---------------------------------------------------------------------------
# Spout2 SDK sources
# ---------------------------------------------------------------------------
spout_sdk_path = "Spout2/SPOUTSDK/SpoutGL"

env.Append(CPPPATH=[
    "src/",
    spout_sdk_path,
])

env.Append(LIBS=[
    "opengl32",
    "d3d11",
    "dxgi",
    "user32",
    "Advapi32",
    "gdi32",
])

spout_sources = [
    os.path.join(spout_sdk_path, f) for f in [
        "Spout.cpp",
        "SpoutCopy.cpp",
        "SpoutDirectX.cpp",
        "SpoutFrameCount.cpp",
        "SpoutGL.cpp",
        "SpoutGLextensions.cpp",
        "SpoutReceiver.cpp",
        "SpoutSender.cpp",
        "SpoutSenderNames.cpp",
        "SpoutSharedMemory.cpp",
        "SpoutUtils.cpp",
    ]
]

ext_sources = Glob("src/*.cpp")
all_sources = ext_sources + spout_sources

# ---------------------------------------------------------------------------
# Output library
# ---------------------------------------------------------------------------
library = env.SharedLibrary(
    target="bin/win64/libgn_spout" + suffix + ".dll",
    source=all_sources,
)

Default(library)
