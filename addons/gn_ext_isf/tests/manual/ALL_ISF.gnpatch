		"isf_shader2": {
			"parameters": {
				"isf_code": {
					"value": "/*{\n\t\"DESCRIPTION\": \"Mirror the input image along a configurable axis\",\n\t\"CREDIT\": \"GONODES\",\n\t\"ISFVSN\": \"2.0\",\n\t\"CATEGORIES\": [\"Distort\"],\n\t\"INPUTS\": [\n\t\t{ \"NAME\": \"src\",  \"TYPE\": \"image\" },\n\t\t{ \"NAME\": \"mode\", \"TYPE\": \"long\",\n\t\t  \"VALUES\": [0, 1, 2, 3],\n\t\t  \"LABELS\": [\"Horizontal\", \"Vertical\", \"Both\", \"Diagonal\"],\n\t\t  \"DEFAULT\": 0 }\n\t]\n}*/\n\nvoid main() {\n\tvec2 uv = isf_FragNormCoord;\n\tif (mode == 0) uv.x = 1.0 - abs(uv.x * 2.0 - 1.0);\n\telse if (mode == 1) uv.y = 1.0 - abs(uv.y * 2.0 - 1.0);\n\telse if (mode == 2) {\n\t\tuv.x = 1.0 - abs(uv.x * 2.0 - 1.0);\n\t\tuv.y = 1.0 - abs(uv.y * 2.0 - 1.0);\n\t} else {\n\t\tfloat tmp = uv.x;\n\t\tuv.x = uv.y;\n\t\tuv.y = tmp;\n\t}\n\tgl_FragColor = IMG_NORM_PIXEL(src, uv);\n}\n"
				},
				"isf_file": {
					"value": ""
				},
				"mode": {
					"value": 2
				},
				"time_dependent": {
					"value": false
				}
			},
			"position": [
				800.0,
				220.0
			],
