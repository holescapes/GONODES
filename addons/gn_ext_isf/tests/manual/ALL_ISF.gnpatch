		},
		"isf_word_boundary": {
			"parameters": {
				"isf_code": {
					"value": "/*{\n  \"DESCRIPTION\": \"Tests word-boundary-safe replacement of DATE FRAMEINDEX TIMEDELTA\",\n  \"CREDIT\": \"GONODES audit\",\n  \"ISFVSN\": \"2.0\",\n  \"CATEGORIES\": [\"TEST\"],\n  \"INPUTS\": [\n    {\"NAME\": \"updateRate\", \"TYPE\": \"float\", \"DEFAULT\": 1.0, \"MIN\": 0.1, \"MAX\": 5.0},\n    {\"NAME\": \"validateDATE\", \"TYPE\": \"float\", \"DEFAULT\": 0.5, \"MIN\": 0.0, \"MAX\": 1.0},\n    {\"NAME\": \"myFRAMEINDEXscale\", \"TYPE\": \"float\", \"DEFAULT\": 0.01, \"MIN\": 0.001, \"MAX\": 0.1}\n  ]\n}*/\n\n// User vars contain ISF keywords as substrings:\n//   updateRate        (contains no keyword)\n//   validateDATE      (contains DATE as suffix)\n//   myFRAMEINDEXscale (contains FRAMEINDEX infix)\n// Word-boundary replacement must NOT corrupt these.\n\nvoid main() {\n    vec2 uv = isf_FragNormCoord;\n    float t = TIME * updateRate;\n    float fi = float(FRAMEINDEX) * myFRAMEINDEXscale;\n    float dt = TIMEDELTA;\n    float yr = DATE.x;\n    float brightness = validateDATE;\n    vec3 col = vec3(\n        sin(uv.x * 6.28 + t) * 0.5 + 0.5,\n        cos(uv.y * 6.28 + fi) * 0.5 + 0.5,\n        sin((uv.x + uv.y) * 3.14 + dt * 100.0 + yr * 0.001) * 0.5 + 0.5\n    );\n    col *= brightness;\n    gl_FragColor = vec4(col, 1.0);\n}\n"
				},
