		},
		"isf_helper_test": {
			"parameters": {
				"isf_code": {
					"value": "/*{\n  \"DESCRIPTION\": \"Tests IMG_THIS_PIXEL and isf_FragNormCoord in helper functions\",\n  \"CREDIT\": \"GONODES audit\",\n  \"ISFVSN\": \"2.0\",\n  \"CATEGORIES\": [\"TEST\"],\n  \"INPUTS\": [\n    {\"NAME\": \"inputImage\", \"TYPE\": \"image\"},\n    {\"NAME\": \"strength\", \"TYPE\": \"float\", \"DEFAULT\": 0.5, \"MIN\": 0.0, \"MAX\": 1.0}\n  ]\n}*/\n\n// Helper function at file scope uses isf_FragNormCoord\n// This tests that isf_FragNormCoord is a valid varying (not UV)\nvec4 sampleCenter(sampler2D img) {\n    return IMG_THIS_PIXEL(img);\n}\n\nvec2 getCoords() {\n    return isf_FragNormCoord;\n}\n\nvoid main() {\n    vec4 center = sampleCenter(inputImage);\n    vec2 uv = getCoords();\n    vec2 offset = (uv - 0.5) * strength;\n    vec4 shifted = IMG_NORM_PIXEL(inputImage, uv + offset);\n    gl_FragColor = mix(center, shifted, strength);\n}\n"
				},
				"isf_file": {
					"value": ""
				},
				"strength": {
					"value": 0.62
				},
				"time_dependent": {
					"value": false
				}
			},
			"position": [
				820.0,
				1160.0
			],
			"type": "ISFTOP"
		},
		"isf_multipass": {
			"parameters": {
				"isf_code": {
					"value": "/*{\n  \"DESCRIPTION\": \"Tests multi-pass with persistent buffer (motion trail)\",\n  \"CREDIT\": \"GONODES audit\",\n  \"ISFVSN\": \"2.0\",\n  \"CATEGORIES\": [\"TEST\"],\n  \"INPUTS\": [\n    {\"NAME\": \"trailDecay\", \"TYPE\": \"float\", \"DEFAULT\": 0.95, \"MIN\": 0.5, \"MAX\": 0.99}\n  ],\n  \"PASSES\": [\n    {\"TARGET\": \"trailBuffer\", \"PERSISTENT\": true, \"FLOAT\": true},\n    {}\n  ]\n}*/\n\nvoid main() {\n    if (PASSINDEX == 0) {\n        // Pass 0: accumulate into persistent buffer\n        vec4 prev = IMG_NORM_PIXEL(trailBuffer, isf_FragNormCoord);\n        // Animated dot position\n        float cx = 0.5 + 0.3 * cos(TIME * 1.5);\n        float cy = 0.5 + 0.3 * sin(TIME * 2.0);\n        float d = distance(isf_FragNormCoord, vec2(cx, cy));\n        float dot = smoothstep(0.05, 0.0, d);\n        vec4 fresh = vec4(dot, dot * 0.6, dot * 0.2, 1.0);\n        gl_FragColor = max(prev * trailDecay, fresh);\n    } else {\n        // Pass 1: output from trail buffer with gamma\n        vec4 trail = IMG_NORM_PIXEL(trailBuffer, isf_FragNormCoord);\n        gl_FragColor = vec4(pow(trail.rgb, vec3(0.8)), 1.0);\n    }\n}\n"
				},
				"isf_file": {
					"value": ""
				},
				"resolution": {
					"value": {
						"_type": "Vector2i",
						"x": 512,
						"y": 512
					}
				},
				"time_dependent": {
					"value": true
				},
				"trailDecay": {
					"value": 0.95
				}
			},
			"position": [
				820.0,
				1640.0
			],
			"type": "ISFTOP"
		},
		"isf_shader": {
			"parameters": {
				"color_shift": {
					"value": 0.5
				},
				"isf_code": {
					"value": "/*{\n  \"DESCRIPTION\": \"Plasma globe pattern\",\n  \"CREDIT\": \"GoNodes demo\",\n  \"ISFVSN\": \"2\",\n  \"CATEGORIES\": [\"Generator\"],\n  \"INPUTS\": [\n    {\"NAME\": \"speed\", \"TYPE\": \"float\", \"DEFAULT\": 1.0, \"MIN\": 0.0, \"MAX\": 5.0},\n    {\"NAME\": \"scale\", \"TYPE\": \"float\", \"DEFAULT\": 3.0, \"MIN\": 0.5, \"MAX\": 10.0},\n    {\"NAME\": \"color_shift\", \"TYPE\": \"float\", \"DEFAULT\": 0.5, \"MIN\": 0.0, \"MAX\": 1.0}\n  ]\n}*/\n\nvoid main() {\n  vec2 uv = isf_FragNormCoord * scale;\n  float t = TIME * speed;\n  float v = sin(uv.x * 3.0 + t) + sin(uv.y * 2.0 + t * 1.3) + sin((uv.x + uv.y) * 1.5 + t * 0.7);\n  v = v / 3.0 * 0.5 + 0.5;\n  vec3 col = vec3(\n    sin(v * 6.28 + color_shift * 6.28) * 0.5 + 0.5,\n    sin(v * 6.28 + 2.09 + color_shift * 6.28) * 0.5 + 0.5,\n    sin(v * 6.28 + 4.19 + color_shift * 6.28) * 0.5 + 0.5\n  );\n  gl_FragColor = vec4(col, 1.0);\n}\n"
				},
				"isf_file": {
					"value": ""
				},
				"resolution": {
					"value": {
						"_type": "Vector2i",
						"x": 512,
						"y": 512
