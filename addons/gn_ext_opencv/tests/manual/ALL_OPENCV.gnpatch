    "annotations": [
        {
            "id": "ann_title",
            "type": "note",
            "text": "ALL_OPENCV — Full Extension Demo\n\nDemonstrates all 20 gn_ext_opencv operators.\n7 operators have dual outputs (IMG + DAT/CHOP).\nRequires GNOpenCV GDExtension + webcam.\n\nTop: Threshold → Morph → Contour / Blob\nMiddle: BG Subtract, Optical Flow, Color Track, Object Track\nBottom: Hough, Convolve, Calibration, ArUco, QR, Feature Match",
            "position": [
                -200.0,
                -200.0
            ],
            "size": [
                650.0,
                220.0
            ],
            "color": [
                0.2,
                0.6,
                1.0,
                0.9
            ]
        },
        {
            "id": "ann_tier1",
            "type": "note",
