[configuration]
entry_symbol = "gn_opencv_init"
compatibility_minimum = 4.1

[libraries]
windows.debug.x86_64 = "res://addons/gn_ext_opencv/native/bin/win64/libgn_opencv.windows.template_release.x86_64.dll"
windows.release.x86_64 = "res://addons/gn_ext_opencv/native/bin/win64/libgn_opencv.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/gn_ext_opencv/native/bin/linux64/libgn_opencv.linux.template_release.x86_64.so"
linux.release.x86_64 = "res://addons/gn_ext_opencv/native/bin/linux64/libgn_opencv.linux.template_release.x86_64.so"
macos.debug = "res://addons/gn_ext_opencv/native/bin/macos/libgn_opencv.macos.template_release.framework"
macos.release = "res://addons/gn_ext_opencv/native/bin/macos/libgn_opencv.macos.template_release.framework"
