class_name PdSynthCHOP
extends GNChopBase
## Run a Pure Data patch as an audio synthesizer.
## Outputs stereo audio generated by the Pd patch.

var _engine: GNPdEngine = null
var _patch_loaded: bool = false
var _last_patch: String = ""


func _init() -> void:
	node_type = "pdsynth"
	time_dependent = true


func _init_ports() -> void:
	add_output("out", GNFamily.Type.CHOP, "Stereo audio output from Pd patch")


func _init_parameters() -> void:
	add_parameter(GNParameter.create_string("patch", "",
		"Patch", "Path to Pure Data (.pd) patch file"))
	add_parameter(GNParameter.create_int("buffer_size", 512, 64, 8192,
		"Buffer Size", "Output buffer size in samples"))
	add_parameter(GNParameter.create_float("frequency", 440.0, 0.001, 20000.0, 0.1,
		"Frequency", "Send frequency value to 'freq' receiver in Pd"))
	add_parameter(GNParameter.create_float("amplitude", 1.0, 0.0, 2.0, 0.01,
		"Amplitude", "Send amplitude value to 'amp' receiver in Pd"))
	add_parameter(GNParameter.create_int("note", 60, 0, 127,
		"Note", "MIDI note number to send"))
	add_parameter(GNParameter.create_int("velocity", 100, 0, 127,
		"Velocity", "MIDI velocity (0 = note off)"))
	add_parameter(GNParameter.create_bool("trigger", false,
		"Trigger", "Send a bang to 'trigger' receiver"))


func _cook(_inputs: Array[GNData]) -> GNData:
	if not _engine:
		_engine = GNPdEngine.new()
		_engine.init_audio(44100.0, 0, 2)

	if not _engine.is_available():
		return null

	var patch_path: String = get_param_value("patch")
	if patch_path != _last_patch:
		if _last_patch != "":
			_engine.close_patch(_last_patch)
		if patch_path != "":
			_engine.open_patch(patch_path)
		_last_patch = patch_path
		_patch_loaded = patch_path != ""

	if not _patch_loaded:
		return null

	# Send parameter values to Pd
	_engine.send_float("freq", get_param_value("frequency"))
	_engine.send_float("amp", get_param_value("amplitude"))
	if get_param_value("trigger"):
		_engine.send_bang("trigger")

	var buffer_size: int = get_param_value("buffer_size")
	var block_size: int = _engine.get_block_size()
	var ticks: int = maxi(1, buffer_size / block_size)
	var actual_frames: int = ticks * block_size
	var sr: float = 44100.0

	# Process Pd — empty input (synth mode), stereo output
	var input := PackedFloat32Array()
	var output: PackedFloat32Array = _engine.process_audio(input, ticks)

	var out := _prepare_output(sr)
	var left := PackedFloat32Array()
	var right := PackedFloat32Array()
	left.resize(actual_frames)
	right.resize(actual_frames)

	for i in range(mini(actual_frames, output.size() / 2)):
		left[i] = output[i * 2]
		right[i] = output[i * 2 + 1]

	out.channels["left"] = left
	out.channels["right"] = right
	out.length = actual_frames
	return out
