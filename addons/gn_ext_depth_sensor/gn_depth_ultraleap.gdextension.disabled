[configuration]
entry_symbol = "gn_depth_ultraleap_init"
compatibility_minimum = 4.1

# Vendor runtime DLL (LeapC.dll) is installed system-wide by the Ultraleap
# Tracking Software installer and found via the OS library search path.

[libraries]
windows.x86_64.debug = "res://addons/gn_ext_depth_sensor/native/ultraleap/bin/win64/libgn_depth_ultraleap.windows.template_release.x86_64.dll"
windows.x86_64.release = "res://addons/gn_ext_depth_sensor/native/ultraleap/bin/win64/libgn_depth_ultraleap.windows.template_release.x86_64.dll"
; DISABLED (missing file): linux.x86_64.debug = "res://addons/gn_ext_depth_sensor/native/ultraleap/bin/linux64/libgn_depth_ultraleap.linux.template_release.x86_64.so"
; DISABLED (missing file): linux.x86_64.release = "res://addons/gn_ext_depth_sensor/native/ultraleap/bin/linux64/libgn_depth_ultraleap.linux.template_release.x86_64.so"
