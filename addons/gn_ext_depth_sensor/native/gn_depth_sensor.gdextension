[configuration]
entry_symbol = "gn_depth_sensor_init"
compatibility_minimum = 4.1

# No [dependencies] section needed — vendor runtime DLLs (LeapC.dll, k4a.dll,
# realsense2.dll) are installed system-wide by their respective vendor software
# and found via the OS library search path (system PATH on Windows,
# LD_LIBRARY_PATH / system ldconfig on Linux).
# If a vendor DLL is missing, this extension silently fails to load and
# GNDepthSensor does not appear in ClassDB — the extension is skipped.

[libraries]
windows.debug.x86_64 = "res://addons/gn_ext_depth_sensor/native/bin/win64/libgn_depth_sensor.windows.template_release.x86_64.dll"
windows.release.x86_64 = "res://addons/gn_ext_depth_sensor/native/bin/win64/libgn_depth_sensor.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/gn_ext_depth_sensor/native/bin/linux64/libgn_depth_sensor.linux.template_release.x86_64.so"
linux.release.x86_64 = "res://addons/gn_ext_depth_sensor/native/bin/linux64/libgn_depth_sensor.linux.template_release.x86_64.so"
