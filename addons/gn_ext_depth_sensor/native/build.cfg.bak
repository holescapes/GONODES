[library]
name = gn_depth_sensor
entry_symbol = gn_depth_sensor_init
platforms = windows, linux

[sources]
cpp = src/*.cpp
include_dirs = src

[windows]
# Azure Kinect SDK
include_dirs_azure = azure_kinect_sdk/include
lib_dirs_azure = azure_kinect_sdk/lib
libs_azure = k4a, k4abt
defines_azure = GN_DEPTH_HAS_AZURE_KINECT

# Intel RealSense SDK
include_dirs_realsense = realsense_sdk/include
lib_dirs_realsense = realsense_sdk/lib
libs_realsense = realsense2
defines_realsense = GN_DEPTH_HAS_REALSENSE

# Ultraleap SDK
include_dirs_ultraleap = ultraleap_sdk/include
lib_dirs_ultraleap = ultraleap_sdk/lib/x64
libs_ultraleap = LeapC
defines_ultraleap = GN_DEPTH_HAS_ULTRALEAP

[linux]
# Azure Kinect SDK (via apt: libk4a-dev, libk4abt-dev)
libs_azure = k4a, k4abt
defines_azure = GN_DEPTH_HAS_AZURE_KINECT

# Intel RealSense SDK (via apt: librealsense2-dev)
libs_realsense = realsense2
defines_realsense = GN_DEPTH_HAS_REALSENSE

# Ultraleap SDK (install from Ultraleap tracking software)
include_dirs_ultraleap = /usr/include/ultraleap
libs_ultraleap = LeapC
defines_ultraleap = GN_DEPTH_HAS_ULTRALEAP
