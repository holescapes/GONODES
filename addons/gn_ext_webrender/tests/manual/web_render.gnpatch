				"html": {"value": "<!DOCTYPE html><html><head><style>body{margin:0;overflow:hidden;background:#111}canvas{display:block}</style></head><body><canvas id=\"c\"></canvas><script>const c=document.getElementById('c'),x=c.getContext('2d');c.width=640;c.height=360;let t=0;function draw(){t+=0.02;x.fillStyle='rgba(17,17,17,0.1)';x.fillRect(0,0,640,360);for(let i=0;i<6;i++){let a=t+i*Math.PI/3;let cx=320+Math.cos(a)*100;let cy=180+Math.sin(a)*100;let g=x.createRadialGradient(cx,cy,0,cx,cy,80);g.addColorStop(0,`hsl(${(i*60+t*50)%360},100%,60%)`);g.addColorStop(1,'transparent');x.fillStyle=g;x.fillRect(0,0,640,360)}requestAnimationFrame(draw)}draw()</script></body></html>"},
