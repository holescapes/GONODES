    "generator": "GONODES",
    "description": "WebRenderTOP — JavaScript execution. Runs a JS snippet every cook to dynamically update the page.",
    "nodes": {
        "lfo1": {
            "type": "LfoChop",
            "position": [-200, 100],
            "parameters": {
                "type": {"value": 0},
                "frequency": {"value": 0.5},
