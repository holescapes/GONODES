class_name GenericScriptNode
extends GNNode
## Family-less scripting node with multiple typed outputs.
##
## Unlike per-family Script operators (ScriptCHOP, ScriptSOP, etc.) which produce
## a single output of their family type, GenericScriptNode can output **any
## combination** of data types simultaneously via `# @output` annotations.
##
## Annotations:
##   # @input <family>  <description>   — dynamic input port
##   # @output <family> <description>   — dynamic output port (chop, top, sop, dat, img, mat)
##   # @param <type> <name> <default> <description>  — inspector parameter
##
## Context variables (same as per-family scripts + `outputs` array):
##   me      — this GNNode
##   inputs  — Array[GNData] from upstream nodes
##   outputs — Array[GNData] pre-populated with fresh typed data objects
##             (one per @output, in declaration order — write into these)
##   op      — alias for outputs[0] (convenience for single-output scripts)
##   time    — elapsed seconds since start
##   frame   — current frame number
##   dt      — delta time this frame
##   par(n)  — shorthand for me.get_param_value(n)
##   chop(), op_ref(), top(), sop(), dat() — cross-reference other nodes
##
## Example:
##   # @input chop Signal source
##   # @output chop Processed signal
##   # @output dat  Signal info table
##   # @param float gain 1.0 Output gain
##
##   func cook():
##       if inputs[0] != null:
##           for ch in inputs[0].get_channel_names():
##               var v = inputs[0].get_value(ch) * par("gain")
##               outputs[0].set_single_value(ch, v)
##       outputs[1].set_headers(PackedStringArray(["key", "value"]))
##       outputs[1].append_row(PackedStringArray(["time", "%.3f" % time]))


const DEFAULT_CODE := """# @input chop  Signal source
# @output chop Modified signal
# @output dat  Signal info

# @param float gain 1.0 Output gain multiplier

func cook():
	# ── Output 0 (CHOP): scale input or generate sine ──
	if inputs[0] != null:
		for ch in inputs[0].get_channel_names():
			var v = inputs[0].get_value(ch) * par("gain")
			outputs[0].set_single_value(ch, v)
	else:
		outputs[0].set_single_value("out", sin(time) * par("gain"))

	# ── Output 1 (DAT): info table ──
	outputs[1].set_headers(PackedStringArray(["key", "value"]))
	outputs[1].append_row(PackedStringArray(["time", "%.3f" % time]))
	outputs[1].append_row(PackedStringArray(["frame", str(frame)]))
	outputs[1].append_row(PackedStringArray(["gain", str(par("gain"))]))
"""

## Static param names (not generated by @param annotations).
const _STATIC_PARAMS: PackedStringArray = [
	"time_dependent", "cook_once", "force_active", "code",
]

## GNScriptHelper for compilation and runtime execution.
var _helper: GNScriptHelper = GNScriptHelper.new()

## Last compiled code (skip redundant recompiles).
var _last_code: String = ""

## Cached per-port output data keyed by port index.
var _output_data: Array[GNData] = []

## Parsed output annotations from the current code.
var _parsed_outputs: Array = []


func _init() -> void:
	family = GNFamily.Type.COMP  # Gray / neutral color in graph
	node_type = "script"


func _init_ports() -> void:
	# Default ports from annotations in DEFAULT_CODE.
	# Rebuilt dynamically when code changes.
	add_input("in0", GNFamily.Type.CHOP, false, "Signal source", "Input 0")
	add_output("out0", GNFamily.Type.CHOP, "Modified signal", "Output 0")
	add_output("out1", GNFamily.Type.DAT, "Signal info", "Output 1")


func _init_parameters() -> void:
	add_parameter(GNParameter.create_bool("time_dependent", false,
		"Time Dependent", "Re-cook every frame even when inputs haven't changed"))
	add_parameter(GNParameter.create_bool("cook_once", false,
		"Cook Once", "Pulse: toggle ON to force a single cook, auto-resets to OFF"))
	add_parameter(GNParameter.create_bool("force_active", false,
		"Force Active", "Keep this node's chain alive even without a downstream sink"))
	add_parameter(GNParameter.create_string("code", DEFAULT_CODE.strip_edges(),
		"Script Code", "GDScript code with cook(), @output, @input, and @param annotations"))


func _pre_cook(delta: float) -> void:
	time_dependent = get_param_value("time_dependent")
	is_sink = get_param_value("force_active")
	# Cook-once pulse: mark dirty for one frame, then auto-reset
	if get_param_value("cook_once"):
		mark_dirty()
		set_param_value("cook_once", false)
	super._pre_cook(delta)


func _cook(inputs_arr: Array[GNData]) -> GNData:
	var code: String = get_param_value("code")

	# Recompile if code changed
	if code != _last_code:
		_last_code = code
		_helper.on_code_changed(self, code)
		_rebuild_output_ports(code)

	if not _helper.script_ok:
		# Return first cached output or null
		return _output_data[0] if not _output_data.is_empty() else null

	# Pre-create fresh typed data objects for each output port
	var out_array: Array = []
	out_array.resize(_parsed_outputs.size())
	for i in range(_parsed_outputs.size()):
		var ann: GNScriptHelper.OutputAnnotation = _parsed_outputs[i]
		out_array[i] = GNScriptHelper.create_data_for_family(ann.family)

	# Inject outputs into script context and run
	var engine: Node = get_parent()
	if _helper._instance != null:
		_helper._instance.outputs = out_array
		# op = first output for convenience (single-output scripts can use op)
		_helper._instance.op = out_array[0] if not out_array.is_empty() else null

	if _helper.run_cook(self, inputs_arr, out_array[0] if not out_array.is_empty() else null, engine):
		# Store cooked outputs for per-port retrieval
		_output_data.clear()
		for data in out_array:
			if data is GNData:
				data.valid = true
				data.timestamp = current_frame
			_output_data.append(data)
		# Return first output as cached_output (for single-consumer compatibility)
		return _output_data[0] if not _output_data.is_empty() else null
	else:
		return _output_data[0] if not _output_data.is_empty() else null


## Per-port output routing — the cook engine calls this for each downstream wire.
func get_output_data(port_index: int) -> GNData:
	if port_index >= 0 and port_index < _output_data.size():
		return _output_data[port_index]
	return cached_output


# ═══════════════════════════════════════════════════════════════════════════════
# Output Port Rebuild
# ═══════════════════════════════════════════════════════════════════════════════

## Rebuilds output ports from @output annotations.  Called when code changes.
func _rebuild_output_ports(code: String) -> void:
	var annotations: Array = GNScriptHelper.parse_output_annotations(code)

	# Check if anything structurally changed
	if annotations.size() == _parsed_outputs.size():
		var same := true
		for i in range(annotations.size()):
			var new_ann: GNScriptHelper.OutputAnnotation = annotations[i]
			var old_ann: GNScriptHelper.OutputAnnotation = _parsed_outputs[i]
			if new_ann.family != old_ann.family or new_ann.description != old_ann.description:
				same = false
				break
		if same:
			return

	_parsed_outputs = annotations

	# Rebuild output ports
	output_ports.clear()
	for i in range(annotations.size()):
		var ann: GNScriptHelper.OutputAnnotation = annotations[i]
		add_output("out%d" % i, ann.family, ann.description)

	# Clear stale output data (will be re-created on next cook)
	_output_data.clear()

	GNLogger.info("GenericScript", "'%s' output ports → %d (from @output annotations)" % [
		id, annotations.size()])
	ports_changed.emit(id)


# ═══════════════════════════════════════════════════════════════════════════════
# Serialization
# ═══════════════════════════════════════════════════════════════════════════════

## Override from_dict to rebuild dynamic params and ports from saved code.
func from_dict(d: Dictionary) -> void:
	super.from_dict(d)
	var code: String = get_param_value("code")
	if not code.is_empty():
		_last_code = code
		_helper.on_code_changed(self, code)
		_rebuild_output_ports(code)
	if d.has("parameters"):
		GNScriptHelper.restore_dynamic_param_values(self, d["parameters"], _STATIC_PARAMS)
