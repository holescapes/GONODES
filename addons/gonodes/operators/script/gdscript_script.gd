class_name GDScriptSCRIPT
extends GNNode
## GDScript scripting node with multiple typed outputs.
##
## Produces **any combination** of data types simultaneously via `# @output`
## annotations.  A **Template** dropdown provides family-focused starting
## code (CHOP, SOP, DAT, IMG) or a multi-output Generic template.
##
## Annotations:
##   # @input <family>  <description>   — dynamic input port
##   # @output <family> <description>   — dynamic output port (chop, top, sop, dat, img, mat)
##   # @param <type> <name> <default> <description>  — inspector parameter
##
## Context variables:
##   me      — this GNNode
##   inputs  — Array[GNData] from upstream nodes
##   outputs — Array[GNData] pre-populated with fresh typed data objects
##   op      — alias for outputs[0]
##   time    — elapsed seconds since start
##   frame   — current frame number
##   dt      — delta time this frame
##   par(n)  — shorthand for me.get_param_value(n)
##   chop(), op_ref(), top(), sop(), dat() — cross-reference other nodes

## Template choices presented in the inspector dropdown.
enum Template { GENERIC, CHOP, SOP, DAT, IMG }

const _TEMPLATE_NAMES: PackedStringArray = ["Generic", "CHOP", "SOP", "DAT", "IMG"]


const _TPL_GENERIC := """# @input chop  Signal source
# @output chop Modified signal
# @output dat  Signal info

# @param float gain 1.0 Output gain multiplier

func cook():
	# ── Output 0 (CHOP): scale input or generate sine ──
	if inputs[0] != null:
		for ch in inputs[0].get_channel_names():
			var v = inputs[0].get_value(ch) * par("gain")
			outputs[0].set_single_value(ch, v)
	else:
		outputs[0].set_single_value("out", sin(time) * par("gain"))

	# ── Output 1 (DAT): info table ──
	outputs[1].set_headers(PackedStringArray(["key", "value"]))
	outputs[1].append_row(PackedStringArray(["time", "%.3f" % time]))
	outputs[1].append_row(PackedStringArray(["frame", str(frame)]))
	outputs[1].append_row(PackedStringArray(["gain", str(par("gain"))]))
"""


const _TPL_CHOP := """# @input chop Input channels

# @param float speed 1.0 Animation speed
# @param int channels 1 Number of output channels
# @output chop Output channels

func cook():
	var n = par("channels")
	for i in range(n):
		var phase = i * 0.5
		var val = sin(time * par("speed") + phase)
		op.set_single_value("chan%d" % i, val)

# Optional — runs once after recompilation:
# func setup():
#     print("GDScriptCHOP '%s' initialized" % me.id)
"""

const _TPL_SOP := """# @input sop Source geometry

# @param int count 50 Number of scattered points
# @param float radius 2.0 Scatter radius
# @param int seed 0 Random seed (0 = use frame)
# @output sop Output geometry

func cook():
	var st = SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_POINTS)

	var rng = RandomNumberGenerator.new()
	rng.seed = par("seed") if par("seed") != 0 else frame

	var r = par("radius")
	for i in range(par("count")):
		var pos = Vector3(
			rng.randf_range(-1.0, 1.0),
			rng.randf_range(-1.0, 1.0),
			rng.randf_range(-1.0, 1.0)
		).normalized() * r * rng.randf()
		st.set_normal(Vector3.UP)
		st.add_vertex(pos)

	op.set_from_surface_tool(st)
"""

const _TPL_DAT := """# @input dat Input table

# @param int rows 5 Number of data rows
# @param string prefix Row Row name prefix
# @output dat Output table

func cook():
	op.set_headers(PackedStringArray(["name", "index", "time"]))
	var n = par("rows")
	var pfx = par("prefix")
	for i in range(n):
		op.append_row(PackedStringArray([
			"%s_%d" % [pfx, i],
			str(i),
			"%.2f" % time,
		]))
"""

const _TPL_IMG := """# @input img Input image

# @param vec2i resolution 256,256 Output resolution
# @param color fill_color #000000 Background fill color
# @output img Output image

func cook():
	var res = par("resolution")
	var img = Image.create(res.x, res.y, false, Image.FORMAT_RGBA8)
	img.fill(par("fill_color"))

	# Example: draw a moving white rectangle
	var cx = int(res.x * (0.5 + 0.4 * sin(time)))
	var cy = res.y / 2
	var half_w = 20
	var half_h = 20
	for x in range(maxi(cx - half_w, 0), mini(cx + half_w, res.x)):
		for y in range(maxi(cy - half_h, 0), mini(cy + half_h, res.y)):
			img.set_pixel(x, y, Color.WHITE)

	op.set_image(img)
"""


const _TEMPLATES: Dictionary = {
	Template.GENERIC: _TPL_GENERIC,
	Template.CHOP:    _TPL_CHOP,
	Template.SOP:     _TPL_SOP,
	Template.DAT:     _TPL_DAT,
	Template.IMG:     _TPL_IMG,
}

## Static param names (not generated by @param annotations).
const _STATIC_PARAMS: PackedStringArray = [
	"template", "time_dependent", "cook_once", "force_active", "code",
]

## GNScriptHelper for compilation and runtime execution.
var _helper: GNScriptHelper = GNScriptHelper.new()

## Last compiled code (skip redundant recompiles).
var _last_code: String = ""

## Cached per-port output data keyed by port index.
var _output_data: Array[GNData] = []

## Parsed output annotations from the current code.
var _parsed_outputs: Array = []

## Current template index — kept in sync with the "template" parameter.
var _current_template: int = Template.GENERIC

## Last cook duration in milliseconds (for preview display).
var _last_cook_ms: float = 0.0


func _init() -> void:
	family = GNFamily.Type.SCRIPT
	node_type = "script"
	thread_safe = false  # user code can call set_par / network_*


func _init_ports() -> void:
	# Default ports from annotations in the Generic template.
	# Rebuilt dynamically when code changes.
	add_input("in0", GNFamily.Type.CHOP, false, "Signal source", "Input 0")
	add_output("out0", GNFamily.Type.CHOP, "Modified signal", "Output 0")
	add_output("out1", GNFamily.Type.DAT, "Signal info", "Output 1")


func _init_parameters() -> void:
	add_parameter(GNParameter.create_enum("template", _TEMPLATE_NAMES,
		Template.GENERIC, "Template",
		"Starting code template. Changing this replaces the current code."))
	add_parameter(GNParameter.create_bool("time_dependent", false,
		"Time Dependent", "Re-cook every frame even when inputs haven't changed"))
	add_parameter(GNParameter.create_bool("cook_once", false,
		"Cook Once", "Pulse: toggle ON to force a single cook, auto-resets to OFF"))
	add_parameter(GNParameter.create_bool("force_active", false,
		"Force Active", "Keep this node's chain alive even without a downstream sink"))
	add_parameter(GNParameter.create_string("code", _TPL_GENERIC.strip_edges(),
		"Script Code", "GDScript code with cook(), @output, @input, and @param annotations"))


## Called by the registry when the operator entry has a `preset=` key.
## Maps preset names to template enum values and applies the template.
func apply_preset(preset_name: String) -> void:
	var tpl: int = Template.GENERIC
	match preset_name.to_lower():
		"chop": tpl = Template.CHOP
		"sop":  tpl = Template.SOP
		"dat":  tpl = Template.DAT
		"img":  tpl = Template.IMG
	_apply_template(tpl)


func _apply_template(tpl: int) -> void:
	_current_template = tpl
	set_param_value("template", tpl)
	var code: String = _TEMPLATES.get(tpl, _TPL_GENERIC)
	set_param_value("code", code.strip_edges())
	_last_code = ""  # Force recompile on next cook


func _pre_cook(delta: float) -> void:
	time_dependent = get_param_value("time_dependent")
	is_sink = get_param_value("force_active")
	# Cook-once pulse: mark dirty for one frame, then auto-reset
	if get_param_value("cook_once"):
		mark_dirty()
		set_param_value("cook_once", false)
	# Detect template change from parameter inspector
	var tpl_val: int = get_param_value("template")
	if tpl_val != _current_template:
		_apply_template(tpl_val)
	super._pre_cook(delta)


func _cook(inputs_arr: Array[GNData]) -> GNData:
	var code: String = get_param_value("code")

	# Recompile if code changed
	if code != _last_code:
		_last_code = code
		_helper.on_code_changed(self, code)
		_rebuild_output_ports(code)

	if not _helper.script_ok:
		# Return first cached output or null
		return _output_data[0] if not _output_data.is_empty() else null

	# Pre-create fresh typed data objects for each output port
	var out_array: Array = []
	out_array.resize(_parsed_outputs.size())
	for i in range(_parsed_outputs.size()):
		var ann: GNScriptHelper.OutputAnnotation = _parsed_outputs[i]
		out_array[i] = GNScriptHelper.create_data_for_family(ann.family)

	# Inject outputs into script context and run
	var engine: Node = get_parent()
	if _helper._instance != null:
		_helper._instance.outputs = out_array
		# op = first output for convenience (single-output scripts can use op)
		_helper._instance.op = out_array[0] if not out_array.is_empty() else null

	var t0 := Time.get_ticks_usec()
	var cook_ok := _helper.run_cook(self, inputs_arr, out_array[0] if not out_array.is_empty() else null, engine)
	_last_cook_ms = (Time.get_ticks_usec() - t0) / 1000.0

	if cook_ok:
		# Store cooked outputs for per-port retrieval
		_output_data.clear()
		for data in out_array:
			if data is GNData:
				data.valid = true
				data.timestamp = current_frame
			_output_data.append(data)
	return _output_data[0] if not _output_data.is_empty() else null


## Per-port output routing — the cook engine calls this for each downstream wire.
func get_output_data(port_index: int) -> GNData:
	if port_index >= 0 and port_index < _output_data.size():
		return _output_data[port_index]
	return cached_output


## SCRIPT nodes show cook time + status, not data preview.
func update_preview_control(control: Control) -> void:
	if not control is Label:
		return
	var label := control as Label
	if not node_warning.is_empty():
		label.text = "ERR | %s" % node_warning.substr(0, 40)
	elif _last_cook_ms > 0.0:
		label.text = "%.1fms | OK" % _last_cook_ms
	else:
		label.text = ""


# ═══════════════════════════════════════════════════════════════════════════════
# Output Port Rebuild
# ═══════════════════════════════════════════════════════════════════════════════

## Rebuilds output ports from @output annotations.  Called when code changes.
func _rebuild_output_ports(code: String) -> void:
	var annotations: Array = GNScriptHelper.parse_output_annotations(code)

	# Check if anything structurally changed
	if annotations.size() == _parsed_outputs.size():
		var same := true
		for i in range(annotations.size()):
			var new_ann: GNScriptHelper.OutputAnnotation = annotations[i]
			var old_ann: GNScriptHelper.OutputAnnotation = _parsed_outputs[i]
			if new_ann.family != old_ann.family or new_ann.description != old_ann.description:
				same = false
				break
		if same:
			return

	_parsed_outputs = annotations

	# Rebuild output ports
	output_ports.clear()
	for i in range(annotations.size()):
		var ann: GNScriptHelper.OutputAnnotation = annotations[i]
		add_output("out%d" % i, ann.family, ann.description)

	# Clear stale output data (will be re-created on next cook)
	_output_data.clear()

	GNLogger.info("GDScriptSCRIPT", "'%s' output ports → %d (from @output annotations)" % [
		id, annotations.size()])
	ports_changed.emit(id)


# ═══════════════════════════════════════════════════════════════════════════════
# Serialization
# ═══════════════════════════════════════════════════════════════════════════════

## Override from_dict to rebuild dynamic params and ports from saved code.
func from_dict(d: Dictionary) -> void:
	super.from_dict(d)
	# Restore the template selection from saved parameters
	_current_template = get_param_value("template")
	var code: String = get_param_value("code")
	if not code.is_empty():
		_last_code = code
		_helper.on_code_changed(self, code)
		_rebuild_output_ports(code)
	if d.has("parameters"):
		GNScriptHelper.restore_dynamic_param_values(self, d["parameters"], _STATIC_PARAMS)
