class_name ScriptCHOP
extends GNChopBase
## User-scripted CHOP operator.  Write GDScript to generate or transform
## channel data.  Input ports and inspector parameters are declared via
## comment annotations:
##
##   # @input chop  Upstream channels
##   # @param float speed 1.0 Playback speed
##
## The script must define a cook() function.  An optional setup() function
## runs once after each recompilation.
##
## Available context inside cook() / setup():
##   me      — this GNNode (access id, family, etc.)
##   inputs  — Array[GNData] from upstream nodes
##   op      — pre-prepared GNChannelData (call add_channel, set_channel, etc.)
##   time    — elapsed seconds since start
##   frame   — current frame number
##   dt      — delta time this frame
##   par(n)  — shorthand for me.get_param_value(n)
##   chop(), op_ref(), top(), sop(), dat() — cross-reference other nodes

const DEFAULT_CODE := """# @input chop Input channels

# @param float speed 1.0 Animation speed
# @param int channels 1 Number of output channels

func cook():
	var n = par("channels")
	for i in range(n):
		var phase = i * 0.5
		var val = sin(time * par("speed") + phase)
		op.set_single_value("chan%d" % i, val)

# Optional — runs once after recompilation:
# func setup():
#     print("ScriptCHOP '%s' initialized" % me.id)
"""

## Static param names (not generated by @param annotations).
const _STATIC_PARAMS: PackedStringArray = [
	"time_dependent", "code",
]

var _helper: GNScriptHelper = GNScriptHelper.new()
var _last_code: String = ""


func _init() -> void:
	node_type = "scriptchop"
	node_description = "User-scripted CHOP. Write GDScript to generate or transform channel data."


func _init_ports() -> void:
	# Default ports from annotations in DEFAULT_CODE.
	# Will be rebuilt dynamically when code changes.
	add_input("in0", GNFamily.Type.CHOP, false, "Input channels")
	add_output("out", GNFamily.Type.CHOP, "Script output channels")


func _init_parameters() -> void:
	add_parameter(GNParameter.create_bool("time_dependent", false,
		"Time Dependent", "Re-cook every frame even when inputs haven't changed"))
	add_parameter(GNParameter.create_string("code", DEFAULT_CODE.strip_edges(),
		"Script Code", "GDScript code with cook() function and @param/@input annotations"))


func _pre_cook(delta: float) -> void:
	time_dependent = get_param_value("time_dependent")
	super._pre_cook(delta)


func _cook(inputs: Array[GNData]) -> GNData:
	var code: String = get_param_value("code")

	# Recompile if code changed
	if code != _last_code:
		_last_code = code
		_helper.on_code_changed(self, code)

	if not _helper.script_ok:
		# Return last cached output or empty channel data
		return _cached_channel_data if _cached_channel_data != null else _prepare_output()

	# Prepare clean output
	var output := _prepare_output()

	# Find cook engine (parent node in scene tree)
	var engine: Node = get_parent()

	# Run user script
	if _helper.run_cook(self, inputs, output, engine):
		return output
	else:
		# Cook failed — return last good output or empty
		return _cached_channel_data if _cached_channel_data != null else output


## Override from_dict to rebuild dynamic params from saved code.
func from_dict(d: Dictionary) -> void:
	super.from_dict(d)
	var code: String = get_param_value("code")
	if not code.is_empty():
		_last_code = code
		_helper.on_code_changed(self, code)
	if d.has("parameters"):
		GNScriptHelper.restore_dynamic_param_values(self, d["parameters"], _STATIC_PARAMS)
