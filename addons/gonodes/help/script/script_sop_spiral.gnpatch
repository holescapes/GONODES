            "parameters": {
                "time_dependent": {
                    "value": true,
                    "expression": "sin(time * 2.0) * 0.5 + 0.5",
                    "mode": "EXPRESSION"
                },
                "code": {
                    "value": "# GDScriptSCRIPT (SOP template) \u2014 Procedural Point Cloud\n# 'mesh' is an ImmediateMesh, 'frame' is current frame\n\nmesh.clear_surfaces()\nmesh.surface_begin(Mesh.PRIMITIVE_POINTS)\nvar t = frame / 60.0\nfor i in range(100):\n\tvar a = i * 0.0628 + t\n\tvar r = 0.5 + 0.3 * sin(a * 3.0)\n\tvar x = r * cos(a)\n\tvar y = 0.5 * sin(a * 2.0 + t)\n\tvar z = r * sin(a)\n\tmesh.surface_add_vertex(Vector3(x, y, z))\nmesh.surface_end()\n"
                }
            }
        },
