        "compute1": {
            "type": "ComputeShaderTOP",
            "position": [200, 100],
            "parameters": {
                "time_dependent": {"value": false},
                "shader_code": {
                    "value": "#version 450\n\nlayout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;\nlayout(rgba8, set = 0, binding = 0) uniform image2D gn_output;\nlayout(set = 1, binding = 0) uniform sampler2D gn_tex0;\n\nlayout(push_constant, std430) uniform PushConstants {\n\tfloat gn_time;\n\tfloat gn_frame;\n\tfloat gn_res_x;\n\tfloat gn_res_y;\n\tfloat radius;  // = 4.0\n} pc;\n\nvoid main() {\n\tivec2 coords = ivec2(gl_GlobalInvocationID.xy);\n\tivec2 size = imageSize(gn_output);\n\tif (coords.x \u003e= size.x || coords.y \u003e= size.y) return;\n\n\tvec2 uv = (vec2(coords) + 0.5) / vec2(size);\n\tvec2 px = 1.0 / vec2(size);\n\n\t// Separable Gaussian blur (horizontal + vertical in one pass)\n\tint r = int(pc.radius);\n\tfloat sigma = pc.radius * 0.5 + 0.5;\n\tfloat inv2s2 = 1.0 / (2.0 * sigma * sigma);\n\tvec4 sum = vec4(0.0);\n\tfloat wsum = 0.0;\n\n\tfor (int y = -r; y \u003c= r; y++) {\n\t\tfor (int x = -r; x \u003c= r; x++) {\n\t\t\tfloat w = exp(-float(x*x + y*y) * inv2s2);\n\t\t\tvec2 offset = vec2(float(x), float(y)) * px;\n\t\t\tsum += texture(gn_tex0, uv + offset) * w;\n\t\t\twsum += w;\n\t\t}\n\t}\n\n\timageStore(gn_output, coords, sum / wsum);\n}"
                }
            }
        },
