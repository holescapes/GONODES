				"shader_code": {"value": "shader_type canvas_item;\nuniform float time_sec;\n\nvoid fragment() {\n    vec2 uv = UV * 2.0 - 1.0;\n    float d = length(uv);\n    float wave = sin(d * 10.0 - time_sec * 3.0) * 0.5 + 0.5;\n    vec3 col = mix(vec3(0.1, 0.0, 0.4), vec3(1.0, 0.4, 0.0), wave);\n    COLOR = vec4(col, 1.0);\n}"}
			}
		}
