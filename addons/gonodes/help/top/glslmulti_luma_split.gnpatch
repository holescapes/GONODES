{
    "nodes": {
        "noise1": {
            "type": "NoiseTOP",
            "position": [100, 200],
            "parameters": {
                "resolution": {"_type": "Vector2i", "x": 512, "y": 512},
                "monochrome": false
            }
        },
        "glsl_multi1": {
            "type": "GLSLMultiTOP",
            "position": [400, 200],
            "parameters": {
                "shader_code": "shader_type canvas_item;\nuniform sampler2D gn_tex0 : hint_default_white;\n\nvoid fragment() {\n\tvec4 src = texture(gn_tex0, UV);\n\tfloat luma = dot(src.rgb, vec3(0.299, 0.587, 0.114));\n\n\tgn_out0 = src;\n\tgn_out1 = vec4(vec3(luma), src.a);\n}"
            }
        },
        "layout1": {
            "type": "LayoutTOP",
            "position": [700, 200],
            "parameters": {
                "columns": 2,
                "resolution": {"_type": "Vector2i", "x": 1024, "y": 512}
            }
        },
        "text1": {
            "type": "TextTOP",
            "position": [400, 50],
            "parameters": {
                "text": "GLSLMultiTOP — Luma Split\n\nSame shader language as CustomShaderTOP.\nAssign to gn_out0, gn_out1 for multi-output.\nEach output gets its own port.",
                "font_size": 20,
                "resolution": {"_type": "Vector2i", "x": 512, "y": 512}
            }
        },
        "window1": {
            "type": "WindowOUT",
            "position": [1000, 200],
            "parameters": {
                "resolution": {"_type": "Vector2i", "x": 512, "y": 512},
                "open": true
            }
        }
    },
    "connections": [
        {"from": "noise1", "from_port": 0, "to": "glsl_multi1", "to_port": 0},
        {"from": "glsl_multi1", "from_port": 0, "to": "layout1", "to_port": 0},
        {"from": "glsl_multi1", "from_port": 1, "to": "layout1", "to_port": 1},
        {"from": "layout1", "from_port": 0, "to": "window1", "to_port": 0}
    ]
}
