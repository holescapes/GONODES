            "position": [500, 350],
            "parameters": {
                "time_dependent": { "value": true },
                "force_active": { "value": true },
                "code": { "value": "# Bridge CHOP channels to GeometryCOMP and CameraCOMP params\n# Reads PanelTOP CHOP output (colorpicker + slider state)\n# and writes them to the 3D scene operators.\n\nfunc cook():\n    # Read color from panel CHOP channels\n    var r = chop(\"panel1\", \"colorpicker1:r\")\n    var g = chop(\"panel1\", \"colorpicker1:g\")\n    var b = chop(\"panel1\", \"colorpicker1:b\")\n\n    # Set geometry material color\n    set_par(\"geo1\", \"albedo_color\", Color(r, g, b, 1.0))\n\n    # Read slider value and set camera Y rotation\n    var cam_ry = chop(\"panel1\", \"slider_rotation:value\")\n    set_par(\"cam1\", \"ry\", cam_ry)\n\n    # Output the values for monitoring\n    op.set_single_value(\"r\", r)\n    op.set_single_value(\"g\", g)\n    op.set_single_value(\"b\", b)\n    op.set_single_value(\"cam_ry\", cam_ry)\n" }
            }
