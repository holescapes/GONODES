{
    "version":  "1.0.0",
    "generator":  "GONODES",
    "nodes":  {
                  "generic1":  {
                                   "type":  "GenericScriptNode",
                                   "position":  [
                                                    200,
                                                    100
                                                ],
                                   "parameters":  {
                                                      "time_dependent":  {
                                                                             "value":  true
                                                                         },
                                                      "code":  {
                                                                   "value":  "# @input chop  Signal source\n# @output chop Modified signal\n# @output dat  Signal info\n\n# @param float gain 1.0 Output gain multiplier\n# @param float offset 0.0 DC offset\n\nfunc cook():\n\t# ── Output 0 (CHOP): generate a scaled sine ──\n\tvar v = sin(time * 3.0) * par(\"gain\") + par(\"offset\")\n\toutputs[0].set_single_value(\"signal\", v)\n\n\t# ── Output 1 (DAT): info table about the signal ──\n\toutputs[1].set_headers(PackedStringArray([\"key\", \"value\"]))\n\toutputs[1].append_row(PackedStringArray([\"time\", \"%.3f\" % time]))\n\toutputs[1].append_row(PackedStringArray([\"frame\", str(frame)]))\n\toutputs[1].append_row(PackedStringArray([\"signal\", \"%.4f\" % v]))\n\toutputs[1].append_row(PackedStringArray([\"gain\", str(par(\"gain\"))]))"
                                                               }
                                                  }
                               },
