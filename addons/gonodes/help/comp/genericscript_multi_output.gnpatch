{
	"version": "1.0.0",
	"generator": "GONODES",
	"nodes": {
		"generic1": {
			"type": "GenericScriptNode",
			"position": [200, 100],
			"parameters": {
				"time_dependent": {"value": true},
				"code": {"value": "# @input chop  Signal source\n# @output chop Modified signal\n# @output dat  Signal info\n\n# @param float gain 1.0 Output gain multiplier\n# @param float offset 0.0 DC offset\n\nfunc cook():\n\t# ── Output 0 (CHOP): generate a scaled sine ──\n\tvar v = sin(time * 3.0) * par(\"gain\") + par(\"offset\")\n\toutputs[0].set_single_value(\"signal\", v)\n\n\t# ── Output 1 (DAT): info table about the signal ──\n\toutputs[1].set_headers(PackedStringArray([\"key\", \"value\"]))\n\toutputs[1].append_row(PackedStringArray([\"time\", \"%.3f\" % time]))\n\toutputs[1].append_row(PackedStringArray([\"frame\", str(frame)]))\n\toutputs[1].append_row(PackedStringArray([\"signal\", \"%.4f\" % v]))\n\toutputs[1].append_row(PackedStringArray([\"gain\", str(par(\"gain\"))]))"}
			}
		}
	},
	"connections": [],
	"annotations": [
		{
			"id": "ann_1",
			"type": "note",
			"text": "Generic Script Node — Multi-Output\n\nA family-less scripting node that can produce\nany combination of output types via @output\nannotations.\n\nThis example outputs CHOP + DAT simultaneously.\nUse outputs[0], outputs[1], ... to write to each\noutput port. 'op' is an alias for outputs[0].",
			"position": [-100.0, -150.0],
			"size": [500.0, 120.0],
			"color": [0.7, 0.7, 0.9, 0.8]
		},
		{
			"id": "ann_2",
			"type": "note",
			"text": "Each @output creates a typed port:\n  # @output chop → GNChannelData\n  # @output dat  → GNTableData\n  # @output top  → GNTextureData\n  # @output sop  → GNGeoData\n  # @output img  → GNImageData\n  # @output mat  → GNMaterialData",
			"position": [500.0, -150.0],
			"size": [350.0, 120.0],
			"color": [1.0, 1.0, 1.0, 0.8]
		}
	]
}
