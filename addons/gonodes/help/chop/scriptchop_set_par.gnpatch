                                                     "code":  {
                                                                  "value":  "# Demonstrates set_par() for writable references.\n# This script reads its own LFO and dynamically\n# adjusts the upstream LFO frequency based on time.\n\nfunc cook():\n\t# Read current LFO value\n\tvar lfo_val = chop(\"lfo1\", \"lfo\")\n\top.set_single_value(\"lfo\", lfo_val)\n\n\t# Writable ref: modulate LFO frequency over time\n\t# 2-arg form — sets param on *this* node:\n\t#   set_par(\"my_param\", 42)\n\t# 3-arg form — sets param on *another* node:\n\tvar new_freq = 1.0 + sin(time * 0.5) * 0.8\n\tset_par(\"lfo1\", \"frequency\", new_freq)\n\n\top.set_single_value(\"freq\", new_freq)"
                                                              }
                                                 }
                              },
