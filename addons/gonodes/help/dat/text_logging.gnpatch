        "script1": {
            "type": "ScriptCHOP",
            "position": [200, 100],
            "parameters": {
                "time_dependent": { "value": true },
                "code": {
                    "value": "# log() demo — messages appear in the Textport\n# Open the Log panel (bottom toolbar) to see output.\n\n# @param float threshold 0.5 Warn when sine exceeds this\n\nfunc cook():\n\tvar val = sin(time * 2.0)\n\top.set_single_value(\"wave\", val)\n\n\t# log() sends INFO to the Textport\n\tlog(\"frame %d  wave = %.3f\" % [frame, val])\n\n\t# log_warn() if value crosses threshold\n\tif abs(val) > par(\"threshold\"):\n\t\tlog_warn(\"wave %.3f exceeds threshold %.2f\" % [val, par(\"threshold\")])\n\n\t# log_debug() for verbose detail\n\tlog_debug(\"dt = %.4f\" % dt)\n"
                }
            }
        },
        "null1": {
            "type": "NullCHOP",
            "position": [550, 100],
            "parameters": {}
        },
