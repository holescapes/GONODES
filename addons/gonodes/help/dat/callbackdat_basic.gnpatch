        "callback1": {
            "type": "CallbackDAT",
            "position": [
                500,
                100
            ],
            "parameters": {
                "on_cook": {
                    "value": "func cook():\n\t# 'target' is the upstream node being observed\n\t# 'event' is 'cook', 'event_param' is null\n\tvar v = target.get_output_data(0)\n\tif v:\n\t\tvar ch = v.get_channel(\"lfo\")\n\t\tif ch and ch.size() > 0:\n\t\t\tprint(\"LFO cooked: \", ch[0])"
                },
                "on_value_change": {
                    "value": "func cook():\n\t# 'event_param' is the name of the changed parameter\n\tprint(\"Param changed: \", event_param)"
                }
            }
        },
