                                                                       "value":  "func cook():\n\t# \u0027target\u0027 is the upstream node being observed\n\t# \u0027event\u0027 is \u0027cook\u0027, \u0027event_param\u0027 is null\n\tvar v = target.get_output_data(0)\n\tif v:\n\t\tvar ch = v.get_channel(\"lfo\")\n\t\tif ch and ch.size() \u003e 0:\n\t\t\tprint(\"LFO cooked: \", ch[0])"
                                                                   },
                                                       "on_value_change":  {
                                                                               "value":  "func cook():\n\t# \u0027event_param\u0027 is the name of the changed parameter\n\tprint(\"Param changed: \", event_param)"
                                                                           }
                                                   }
