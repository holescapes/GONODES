			"parameters": {
				"code": {"value": "# Network API — Procedural Graph Construction\n# This script builds a mini signal chain at runtime.\n\nfunc cook():\n\t# List current nodes\n\tvar ids = network_node_ids()\n\top.set_headers(PackedStringArray([\"action\", \"detail\"]))\n\top.append_row(PackedStringArray([\"existing\", str(ids.size()) + \" nodes\"]))\n\n\t# Create an LFO and a MathCHOP\n\tvar lfo_id = network_add_node(\"LfoCHOP\", \"auto_lfo\")\n\top.append_row(PackedStringArray([\"created\", lfo_id]))\n\n\tvar math_id = network_add_node(\"MathCHOP\", \"auto_math\")\n\top.append_row(PackedStringArray([\"created\", math_id]))\n\n\t# Wire them: LFO → Math\n\tnetwork_connect(lfo_id, 0, math_id, 0)\n\top.append_row(PackedStringArray([\"connected\", lfo_id + \" → \" + math_id]))\n\n\t# Inspect the new math node\n\tvar info = network_node_info(math_id)\n\tfor key in info:\n\t\top.append_row(PackedStringArray([key, str(info[key])]))"}
			}
		}
	},
