{
    "godotTools.editorPath.godot4": "c:\\Ford\\Godot\\godot\\bin\\godot.windows.editor.x86_64.exe",
    "cmake.ignoreCMakeListsMissing": true,
    "files.watcherExclude": {
        "**/.godot/**": true,
        "**/.import/**": true,
        "**/templates/**": true,
        "**/*.pck": true,
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        "**/addons/gn_ext_*/native/**": true,
        "**/addons/gn_ext_user_python/toolchain/**": true,
        "**/libgonodes/build/**": true,
        "**/*.obj": true,
        "**/*.dblite": true,
        "**/*.lib": true,
        "**/*.exp": true,
        "**/*.pdb": true,
        "**/*.uid": true
    },
    "search.exclude": {
        "**/.godot": true,
        "**/.import": true,
        "**/templates/**": true,
        "**/addons/gn_ext_*/native/**": true,
        "**/addons/gn_ext_user_python/toolchain/**": true,
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        "**/*.uid": true,
        "**/*.import": true,
        "**/*.obj": true,
        "**/*.dblite": true,
        "**/*.lib": true,
        "**/*.exp": true,
        "**/*.vcxproj": true,
        "**/*.vcxproj.filters": true,
        "**/*.sln": true,
        "**/*.user": true,
        "**/*.rc": true,
        "**/*.pdb": true
    },
    "files.exclude": {
        "**/.godot": true,
        "**/.import": true,
        "**/*.uid": true,
        "**/*.import": true,
        "**/*.obj": true,
        "**/*.dblite": true,
        "**/__pycache__": true
    },
    "git.repositoryScanMaxDepth": 1,
    "git.autoRepositoryDetection": "openEditors",

    // ── Tame heavy extensions ──────────────────────────────────────────
    // C++ IntelliSense: disable for this workspace (no day-to-day C++ editing)
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.errorSquiggles": "disabled",

    // Pylance: only analyze open files, ignore SDK/examples
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.analysis.exclude": [
        "**/addons/gn_ext_user_python/**",
        "**/addons/gn_ext_*/native/**",
        "**/build/**",
        "**/.venv/**"
    ],

    // CMake: don't auto-configure (only needed for libgonodes builds)
    "cmake.configureOnOpen": false,
    "cmake.configureOnEdit": false
}