{
    "godotTools.editorPath.godot4": "C:\\Users\\hesam\\OneDrive\\Documents\\Godot\\Godot_v4.7.2-stable_win64.exe\\Godot_v4.7.2-stable_win64.exe",
    "cmake.ignoreCMakeListsMissing": true,
    "files.watcherExclude": {
        "**/.godot/**": true,
        "**/.import/**": true,
        "**/templates/**": true,
        "**/*.pck": true,
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        "**/addons/gn_ext_*/native/**": true,
        "**/addons/gn_ext_user_python/toolchain/**": true,
        "**/libgonodes/build/**": true,
        "**/build/**": true,
        "**/assets/**": true,
        "**/*.obj": true,
        "**/*.dblite": true,
        "**/*.lib": true,
        "**/*.exp": true,
        "**/*.pdb": true,
        "**/*.uid": true,
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true
    },
    "search.exclude": {
        "**/.godot": true,
        "**/.import": true,
        "**/templates/**": true,
        "**/addons/gn_ext_*/native/**": true,
        "**/addons/gn_ext_user_python/toolchain/**": true,
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        "**/build/**": true,
        "**/assets/**": true,
        "**/*.uid": true,
        "**/*.import": true,
        "**/*.obj": true,
        "**/*.dblite": true,
        "**/*.lib": true,
        "**/*.exp": true,
        "**/*.vcxproj": true,
        "**/*.vcxproj.filters": true,
        "**/*.sln": true,
        "**/*.user": true,
        "**/*.rc": true,
        "**/*.pdb": true
    },
    "files.exclude": {
        "**/.godot": true,
        "**/.import": true,
        "**/*.uid": true,
        "**/*.import": true,
        "**/*.obj": true,
        "**/*.dblite": true,
        "**/__pycache__": true,
        "**/build": true,
        "**/assets": true
    },
    "git.repositoryScanMaxDepth": 1,
    "git.autoRepositoryDetection": "openEditors",

    // ── Tame heavy extensions ──────────────────────────────────────────
    // C++ IntelliSense: disable for this workspace (no day-to-day C++ editing)
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.errorSquiggles": "disabled",

    // Pylance: only analyze open files, ignore SDK/examples
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.analysis.exclude": [
        "**/addons/gn_ext_user_python/**",
        "**/addons/gn_ext_*/native/**",
        "**/build/**",
        "**/.venv/**"
    ],

    // CMake: don't auto-configure (only needed for libgonodes builds)
    "cmake.configureOnOpen": false,
    "cmake.configureOnEdit": false,

    // ── Anti-crash measures ────────────────────────────────────────────
    // Reduce extension host memory pressure
    "extensions.experimental.affinity": {},
    "typescript.tsserver.maxTsServerMemory": 512,

    // Limit git diff overhead
    "git.decorations.enabled": false,
    "git.autorefresh": false,

    // Disable telemetry/update checks
    "telemetry.telemetryLevel": "off",
    "update.mode": "none",
    "extensions.autoUpdate": false,

    // ── File watcher / editor memory ───────────────────────────────────
    "files.maxMemoryForLargeFilesMB": 256,
    "editor.largeFileOptimizations": true,
    "editor.bracketPairColorization.enabled": false,
    "editor.suggest.maxVisibleSuggestions": 8,
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.value": 10,
    "terminal.integrated.persistentSessionReviveProcess": "never"
}