# GONODES — Centralized Dependency Versions
# ──────────────────────────────────────────
# All CI workflows and setup_deps.py read from this file.
# To upgrade Godot or godot-cpp, edit ONLY this file.
#
# godot-cpp branch 4.5 is the last stable branch tied to a Godot minor.
# Bindings built for 4.5 load in the 4.7.2 editor and player. godot-cpp 10.x
# can target API 4.7, and that line is still in beta, so releases stay on 4.5.

GODOT_VERSION=4.7.2
GODOTCPP_BRANCH=4.5

# libgonodes C API version (single source of truth for the shared library)
LIBGONODES_VERSION=2.5.0

# gdCEF (Chromium Embedded Framework for WebRenderTOP)
# Release zip: gdcef-{GDCEF_VERSION}_godot-{GDCEF_GODOT}.zip
# https://github.com/Lecrapouille/gdcef/releases
GDCEF_VERSION=0.19.2
GDCEF_GODOT=4.5
