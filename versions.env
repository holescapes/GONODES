# GONODES — Centralized Dependency Versions
# ──────────────────────────────────────────
# All CI workflows and setup_deps.py read from this file.
# To upgrade Godot or godot-cpp, edit ONLY this file.
#
# godot-cpp branches track Godot minor versions (4.5 covers 4.5.x and 4.6.x).
# When a new godot-cpp branch appears (e.g. 4.6), update GODOTCPP_BRANCH here.

GODOT_VERSION=4.6.1
GODOTCPP_BRANCH=4.5

# gdCEF (Chromium Embedded Framework for WebRenderTOP)
# Release zip: gdcef-{GDCEF_VERSION}_godot-{GDCEF_GODOT}.zip
# https://github.com/Lecrapouille/gdcef/releases
GDCEF_VERSION=0.19.2
GDCEF_GODOT=4.5
