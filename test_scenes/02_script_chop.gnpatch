{
	"version": "1.0.0",
	"generator": "GONODES_TEST",
	"nodes": {
		"script1": {
			"type": "ScriptCHOP",
			"position": [100, 100],
			"parameters": {
				"time_dependent": {"value": true},
				"code": {"value": "# @param float speed 2.0 Animation speed\n# @param int channels 3 Number of output channels\n# @param float spread 0.5 Phase spread between channels\n\nfunc cook():\n\tvar n = par(\"channels\")\n\tvar spd = par(\"speed\")\n\tvar spr = par(\"spread\")\n\tfor i in range(n):\n\t\tvar phase = i * spr\n\t\tvar val = sin(time * spd + phase)\n\t\top.set_single_value(\"chan%d\" % i, val)\n"}
			}
		},
		"script_input": {
			"type": "ScriptCHOP",
			"position": [100, 400],
			"parameters": {
				"time_dependent": {"value": false},
				"code": {"value": "# @input chop  Upstream channels\n\nfunc cook():\n\tif inputs.size() > 0 and inputs[0] != null:\n\t\tvar names = inputs[0].get_channel_names()\n\t\tfor ch_name in names:\n\t\t\tvar val = inputs[0].get_value(ch_name)\n\t\t\top.set_single_value(ch_name + \"_abs\", abs(val))\n\telse:\n\t\top.set_single_value(\"no_input\", 0.0)\n"}
			}
		},
		"null1": {
			"type": "NullCHOP",
			"position": [400, 100],
			"parameters": {}
		},
		"null2": {
			"type": "NullCHOP",
			"position": [400, 400],
			"parameters": {}
		}
	},
	"connections": [
		{"from": "script1", "from_port": 0, "to": "null1", "to_port": 0},
		{"from": "script1", "from_port": 0, "to": "script_input", "to_port": 0},
		{"from": "script_input", "from_port": 0, "to": "null2", "to_port": 0}
	],
	"annotations": [
		{
			"id": "ann_1",
			"type": "note",
			"text": "02 — ScriptCHOP\n\nGenerator ScriptCHOP produces 3 sine-wave channels\nwith @param annotations for speed, channels, and spread.\nA Filter ScriptCHOP reads the upstream input and\noutputs the absolute values of each channel.\n\nDemonstrates user-written GDScript inside a CHOP.",
			"position": [-150.0, -200.0],
			"size": [420.0, 170.0],
			"color": [0.15, 0.35, 0.65, 0.85]
		}
	]
