		"shader1": {
			"parameters": {
				"color_a": {
					"value": {
						"_type": "Color",
						"a": 1.0,
						"b": 1.0,
						"g": 0.5,
						"r": 0.0
					}
				},
				"color_b": {
					"value": {
						"_type": "Color",
						"a": 1.0,
						"b": 0.0,
						"g": 0.200000002980232,
						"r": 1.0
					}
				},
				"cook_once": {
					"value": false
				},
				"resolution": {
					"value": {
						"_type": "Vector2i",
						"x": 512,
						"y": 512
					}
				},
				"scale": {
					"value": 4.99
				},
				"shader_code": {
					"value": "shader_type canvas_item;\n\nuniform float speed = 1.0;\nuniform float scale = 5.0;\nuniform vec4 color_a : source_color = vec4(0.0, 0.5, 1.0, 1.0);\nuniform vec4 color_b : source_color = vec4(1.0, 0.2, 0.0, 1.0);\nuniform vec2 gn_resolution;\n\nvoid fragment() {\n\tvec2 uv = UV * scale;\n\tfloat t = TIME * speed;\n\tfloat v = sin(uv.x + t) * sin(uv.y + t * 0.7);\n\tv = v * 0.5 + 0.5;\n\tCOLOR = mix(color_a, color_b, v);\n}\n"
				},
				"speed": {
					"value": 1.0
				},
				"time_dependent": {
					"value": true
				}
			},
			"position": [
				100.0,
				100.0
			],
			"type": "CustomShaderTOP"
		},
		"shader_filter": {
			"parameters": {
				"cook_once": {
					"value": false
				},
				"distortion": {
					"value": 0.27
				},
				"shader_code": {
					"value": "shader_type canvas_item;\n\nuniform sampler2D gn_tex0 : hint_default_white;\nuniform float distortion = 0.02;\nuniform float wave_speed = 3.0;\n\nvoid fragment() {\n\tvec2 uv = UV;\n\tuv.x += sin(uv.y * 20.0 + TIME * wave_speed) * distortion;\n\tuv.y += cos(uv.x * 20.0 + TIME * wave_speed) * distortion;\n\tCOLOR = texture(gn_tex0, uv);\n}\n"
				},
				"time_dependent": {
					"value": true
				},
				"wave_speed": {
					"value": 3.0
				}
			},
			"position": [
				500.0,
				100.0
			],
			"type": "CustomShaderTOP"
		},
		"shader_multi_input": {
			"parameters": {
				"cook_once": {
					"value": false
				},
				"mix_amount": {
					"value": 0.76
				},
				"shader_code": {
					"value": "shader_type canvas_item;\n\nuniform sampler2D gn_tex0 : hint_default_white;\nuniform sampler2D gn_tex1 : hint_default_black;\nuniform float mix_amount = 0.5;\n\nvoid fragment() {\n\tvec4 a = texture(gn_tex0, UV);\n\tvec4 b = texture(gn_tex1, UV);\n\tCOLOR = mix(a, b, mix_amount);\n}\n"
				},
				"time_dependent": {
					"value": true
				}
			},
			"position": [
				500.0,
				400.0
			],
			"type": "CustomShaderTOP"
